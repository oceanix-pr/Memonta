        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El análisis de imagen se interrumpió inesperadamente. Vuelve a intentarlo (la parte ya completada se conserva)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'analyse d'image a été interrompue de façon inattendue. Réessayez (la partie déjà terminée est conservée)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छवि विश्लेषण अप्रत्याशित रूप से बाधित हुआ। कृपया पुनः प्रयास करें (पूरा हुआ भाग सुरक्षित रहेगा)।"
