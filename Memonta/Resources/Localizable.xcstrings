    "重新导入视频后才能抽取关键帧；已生成的画面要点仍会保留。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استخراج الإطارات الرئيسية إلا بعد إعادة استيراد الفيديو، وستبقى الملاحظات المرئية التي أُنشئت سابقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyframes lassen sich erst nach erneutem Import des Videos extrahieren; bereits erstellte visuelle Notizen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyframes can only be extracted after importing the video again; visual notes that were already generated are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se pueden extraer fotogramas clave tras volver a importar el vídeo; las notas visuales ya generadas se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les images clés ne peuvent être extraites qu'après avoir réimporté la vidéo ; le résumé visuel déjà généré est conservé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कीफ़्रेम केवल वीडियो दोबारा आयात करने के बाद ही निकाले जा सकते हैं; पहले से बने दृश्य नोट्स सुरक्षित रहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyframe hanya dapat diekstrak setelah mengimpor ulang video; catatan visual yang sudah dibuat tetap disimpan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I fotogrammi chiave si possono estrarre solo dopo aver reimportato il video; le note visive già generate vengono conservate."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーフレームを抽出するには動画を再取り込みする必要があります。生成済みの画面メモは保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상을 다시 가져와야 키프레임을 추출할 수 있습니다. 이미 생성된 화면 요약은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keyframes kunnen pas worden geëxtraheerd nadat de video opnieuw is geïmporteerd; al gemaakte visuele notities blijven bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klatki kluczowe można wyodrębnić dopiero po ponownym zaimportowaniu filmu; wygenerowane wcześniej notatki wizualne pozostaną."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só é possível extrair fotogramas-chave depois de importar o vídeo novamente; as notas visuais já geradas são mantidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Извлечь ключевые кадры можно только после повторного импорта видео; уже созданные визуальные заметки сохранятся."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyckelbildrutor kan bara extraheras efter att videon importerats igen; redan skapade visuella anteckningar finns kvar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ต้องนำเข้าวิดีโออีกครั้งจึงจะแยกคีย์เฟรมได้ ส่วนบันทึกภาพที่สร้างไว้แล้วจะยังคงอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kareler ancak video yeniden içe aktarıldıktan sonra çıkarılabilir; önceden oluşturulan görsel notlar korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключові кадри можна видобути лише після повторного імпорту відео; уже створені візуальні нотатки збережуться."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ có thể trích xuất khung hình chính sau khi nhập lại video; ghi chú hình ảnh đã tạo vẫn được giữ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新导入视频后才能抽取关键帧；已生成的画面要点仍会保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新匯入影片後才能擷取關鍵影格；已產生的畫面要點仍會保留。"
          }
        }
      }
    },
