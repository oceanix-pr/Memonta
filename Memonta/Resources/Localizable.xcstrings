    "文字标注可设置字号、粗体、斜体和颜色；双击已有文字标注可二次编辑" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدعم تعليقات النص تعيين حجم الخط والخط العريض والمائل واللون؛ انقر نقرًا مزدوجًا على تعليق نص قائم لتعديله مجددًا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textannotationen unterstützen Schriftgröße, Fett, Kursiv und Farbe; doppelklicken Sie auf vorhandene Textannotationen, um sie erneut zu bearbeiten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Text annotations support font size, bold, italic, and color settings; double-click existing text annotations to re-edit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las anotaciones de texto admiten tamaño de fuente, negrita, cursiva y color; haga doble clic en una anotación existente para volver a editarla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les annotations de texte prennent en charge la taille de police, le gras, l'italique et la couleur ; double-cliquez sur une annotation existante pour la modifier à nouveau"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पाठ एनोटेशन फ़ॉन्ट आकार, बोल्ड, इटैलिक और रंग समर्थित करते हैं; मौजूदा पाठ एनोटेशन पर डबल-क्लिक कर पुनः संपादित करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anotasi teks mendukung ukuran font, tebal, miring, dan warna; klik dua kali anotasi teks yang ada untuk mengedit ulang"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le annotazioni di testo supportano dimensione del font, grassetto, corsivo e colore; fai doppio clic su un'annotazione esistente per modificarla di nuovo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "テキスト注釈は文字サイズ、太字、斜体、色を設定できます。既存のテキスト注釈はダブルクリックで再編集できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "텍스트 주석은 글자 크기, 굵게, 기울임, 색상을 설정할 수 있으며, 기존 텍스트 주석을 두 번 클릭해 다시 편집할 수 있습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tekstannotaties ondersteunen lettergrootte, vet, cursief en kleur; dubbelklik op bestaande tekstannotaties om ze opnieuw te bewerken"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adnotacje tekstowe obsługują rozmiar czcionki, pogrubienie, kursywę i kolor; kliknij dwukrotnie istniejącą adnotację, aby edytować ją ponownie"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As anotações de texto oferecem tamanho de fonte, negrito, itálico e cor; clique duas vezes em uma anotação existente para reeditá-la"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текстовые аннотации поддерживают размер шрифта, полужирный, курсив и цвет; дважды щёлкните существующую аннотацию, чтобы изменить её снова"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Textannoteringar stöder teckenstorlek, fet, kursiv och färg; dubbelklicka på en befintlig textannotering för att redigera igen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คำอธิบายประกอบแบบข้อความกำหนดขนาดตัวอักษร ตัวหนา ตัวเอียง และสีได้ ดับเบิลคลิกคำอธิบายประกอบที่มีอยู่เพื่อแก้ไขอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metin açıklamaları yazı boyutu, kalın, eğik ve rengi destekler; mevcut bir metin açıklamasını yeniden düzenlemek için çift tıklayın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Текстові анотації підтримують розмір шрифту, напівжирний, курсив і колір; двічі клацніть наявну анотацію, щоб відредагувати її знову"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chú thích chữ hỗ trợ cỡ chữ, đậm, nghiêng và màu; nhấp đúp chú thích chữ hiện có để sửa lại"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字标注可设置字号、粗体、斜体和颜色；双击已有文字标注可二次编辑"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字標註可設定字級、粗體、斜體與顏色；雙擊既有文字標註可二次編輯"
          }
        }
      }
