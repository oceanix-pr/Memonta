    "需要自定义服务地址、多模型切换或视觉模型时，可以开启专业模式。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغِّل الوضع الاحترافي عندما تحتاج إلى عنوان خدمة مخصّص، أو التبديل بين عدة نماذج، أو نماذج الرؤية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie den Profi-Modus, wenn Sie eine eigene Dienstadresse, mehrere Modellwechsel oder Vision-Modelle benötigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Pro Mode when you need a custom service address, multiple model switching, or vision models."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el modo profesional cuando necesites una dirección de servicio personalizada, cambiar entre varios modelos o modelos de visión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez le mode pro si vous avez besoin d'une adresse de service personnalisée, de plusieurs modèles commutables ou de modèles de vision."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आपको कस्टम सेवा पता, कई मॉडलों के बीच स्विचिंग या विज़न मॉडल चाहिए, तब प्रो मोड चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan Mode Pro saat Anda memerlukan alamat layanan khusus, peralihan antar banyak model, atau model visi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva la modalità Pro quando hai bisogno di un indirizzo di servizio personalizzato, del cambio tra più modelli o di modelli di visione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタムのサービスアドレス、複数モデルの切り替え、ビジョンモデルが必要なときはプロモードをオンにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자 지정 서비스 주소, 여러 모델 전환 또는 비전 모델이 필요하면 프로 모드를 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel Pro-modus in wanneer u een aangepast serviceadres, meerdere modelwissels of vision-modellen nodig hebt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz tryb Pro, gdy potrzebujesz niestandardowego adresu usługi, przełączania wielu modeli lub modeli wizyjnych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o modo Pro quando precisar de um endereço de serviço personalizado, de alternar entre vários modelos ou de modelos de visão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите профессиональный режим, если нужен собственный адрес сервиса, переключение между несколькими моделями или модели компьютерного зрения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera proläge när du behöver en anpassad tjänstadress, växling mellan flera modeller eller visionsmodeller."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดโหมดโปรเมื่อคุณต้องใช้ที่อยู่บริการที่กำหนดเอง การสลับหลายโมเดล หรือโมเดลวิชัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Özel hizmet adresi, birden çok model arasında geçiş veya görü modelleri gerektiğinde Pro Mod'u açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть професійний режим, якщо потрібна власна адреса сервісу, перемикання кількох моделей або моделі комп'ютерного зору."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật Chế độ chuyên nghiệp khi bạn cần địa chỉ dịch vụ tùy chỉnh, chuyển đổi nhiều mô hình hoặc mô hình thị giác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要自定义服务地址、多模型切换或视觉模型时，可以开启专业模式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "需要自訂服務位址、多模型切換或視覺模型時，可以開啟專業模式。"
          }
        }
      }
    },
    "需要选择具体麦克风、单独录制系统声音或跟随会议软件静音时，可以开启专业模式。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شغِّل الوضع الاحترافي عندما تحتاج إلى اختيار ميكروفون معيّن، أو تسجيل صوت النظام على حدة، أو متابعة كتم تطبيق الاجتماع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie den Profi-Modus, wenn Sie ein bestimmtes Mikrofon wählen, Systemaudio separat aufnehmen oder die Stummschaltung der Meeting-App übernehmen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Pro Mode when you need to pick a specific microphone, record system audio separately, or follow the meeting app's mute state."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa el modo profesional cuando necesites elegir un micrófono concreto, grabar el audio del sistema por separado o seguir el silencio de la app de reuniones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez le mode pro si vous devez choisir un microphone précis, enregistrer séparément l'audio système ou suivre la sourdine de l'app de réunion."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जब आपको विशिष्ट माइक्रोफ़ोन चुनना, सिस्टम ऑडियो अलग से रिकॉर्ड करना या मीटिंग ऐप के म्यूट का अनुसरण करना हो, तब प्रो मोड चालू करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktifkan Mode Pro saat Anda perlu memilih mikrofon tertentu, merekam audio sistem secara terpisah, atau mengikuti bisu aplikasi rapat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva la modalità Pro quando devi scegliere un microfono specifico, registrare l'audio di sistema separatamente o seguire il mute dell'app di riunione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "特定のマイクを選ぶ、システム音声を個別に録音する、会議アプリのミュートに追従する必要があるときは、プロモードをオンにします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "특정 마이크 선택, 시스템 오디오 별도 녹음 또는 회의 앱 음소거 연동이 필요하면 프로 모드를 켜세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel Pro-modus in wanneer u een specifieke microfoon wilt kiezen, systeemaudio apart wilt opnemen of het dempen van de vergaderapp wilt volgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz tryb Pro, gdy chcesz wybrać konkretny mikrofon, nagrywać dźwięk systemowy osobno lub podążać za wyciszeniem aplikacji do spotkań."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o modo Pro quando precisar de escolher um microfone específico, gravar o áudio do sistema em separado ou seguir o silêncio da app de reuniões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите профессиональный режим, если нужно выбрать конкретный микрофон, записывать системный звук отдельно или следовать отключению звука в приложении встречи."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivera proläge när du behöver välja en specifik mikrofon, spela in systemljud separat eller följa mötesappens tystläge."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เปิดโหมดโปรเมื่อคุณต้องเลือกไมโครโฟนเฉพาะ บันทึกเสียงระบบแยก หรือตามการปิดเสียงของแอปประชุม"
