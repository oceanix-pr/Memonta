    "转写完成后，切换到「总结」Tab，点击「生成总结」" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد اكتمال التفريغ، انتقل إلى تبويب «الملخص» وانقر «إنشاء ملخص»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechseln Sie nach Abschluss der Transkription zum Tab „Zusammenfassung“ und klicken Sie auf „Zusammenfassung erstellen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After transcription is complete, switch to the \"Summary\" tab and click \"Generate Summary\"."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando termine la transcripción, cambie a la pestaña “Resumen” y pulse “Generar resumen”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois la transcription terminée, passez à l'onglet « Résumé » et cliquez sur « Générer le résumé »."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रांसक्रिप्शन पूरा होने के बाद “सारांश” टैब पर जाएँ और “सारांश बनाएँ” क्लिक करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah transkripsi selesai, beralih ke tab “Ringkasan” dan klik “Buat Ringkasan”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al termine della trascrizione, passa alla scheda “Riepilogo” e fai clic su “Genera riepilogo”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字起こしが完了したら「要約」タブに切り替え、「要約を生成」をクリックします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전사가 완료되면 “요약” 탭으로 전환하고 “요약 생성”을 클릭하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel na voltooiing van de transcriptie naar het tabblad “Samenvatting” en klik op “Samenvatting genereren”."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zakończeniu transkrypcji przejdź do karty „Podsumowanie” i kliknij „Generuj podsumowanie”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após concluir a transcrição, mude para a aba “Resumo” e clique em “Gerar Resumo”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "После завершения транскрипции перейдите на вкладку «Резюме» и нажмите «Создать резюме»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När transkriptionen är klar, växla till fliken “Sammanfattning” och klicka på “Skapa sammanfattning”."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อถอดเสียงเสร็จ ให้สลับไปแท็บ “สรุป” แล้วคลิก “สร้างสรุป”"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Döküm tamamlandıktan sonra “Özet” sekmesine geçin ve “Özet Oluştur”a tıklayın."
          }
        },
        "uk" : {
          "stringUnit" : {
