    "目标位置所在磁盘当前不可用（可能是外置卷已断开）。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قرص الموقع الهدف غير متاح حاليًا (ربما تم فصل وحدة التخزين الخارجية)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Datenträger am Zielort ist derzeit nicht verfügbar (möglicherweise wurde das externe Volume getrennt)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The disk for the target location is currently unavailable (the external volume may be disconnected)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El disco de la ubicación de destino no está disponible en este momento (es posible que el volumen externo se haya desconectado)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
