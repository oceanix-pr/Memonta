            "value" : "Aufgaben können manuell hinzugefügt, bearbeitet und gelöscht werden – nicht an AI-Ergebnisse gebunden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To-dos can be added, edited and deleted manually — not locked to AI results"
          }
