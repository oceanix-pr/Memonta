          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prend en charge l'enregistrement du microphone et de la sortie audio du système (macOS uniquement). Les fichiers sont stockés dans le dossier Memonta du dossier Documents, groupés par mois et nommés par date et heure."
          }
        },
        "hi" : {
