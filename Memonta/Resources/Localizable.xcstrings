            "value" : "Потягніть, щоб вибрати область, клацніть, щоб захопити вікно, натисніть Пробіл для всього екрана"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để chọn vùng, nhấp để chụp cửa sổ, nhấn Space cho toàn màn hình"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖拽框选区域，点击截取窗口，按空格全屏"
