          "stringUnit" : {
            "state" : "translated",
            "value" : "Datenbank-Initialisierung fehlgeschlagen; die App kann nicht im normalen Modus starten.\nPrüfen Sie den Speicherplatz oder die Berechtigungen des Datenordners und versuchen Sie es erneut.\nGenaue Ursache: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Database initialization failed; the app cannot start in normal mode.\nCheck disk space or the data folder permissions and try again.\nDetails: %@"
