    "磁盘剩余空间不足 1GB，按当前码率较快写满，请尽快停止录音或清理磁盘。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المساحة المتاحة أقل من 1GB؛ وبالمعدل الحالي ستمتلئ قريبًا — أوقف التسجيل أو حرّر مساحة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger als 1 GB Speicherplatz frei; bei der aktuellen Bitrate ist er bald voll — Aufnahme stoppen oder Platz freigeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Less than 1 GB of disk space left; at the current bitrate it will fill up soon — stop recording or free up space."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Queda menos de 1 GB de disco; con la tasa actual se llenará pronto: detén la grabación o libera espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de 1 Go d’espace disque ; au débit actuel, il sera vite saturé — arrêtez l’enregistrement ou libérez de l’espace."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1GB से कम जगह बची है; मौजूदा बिटरेट पर यह जल्दी भर जाएगी — रिकॉर्डिंग रोकें या जगह खाली करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang disk tersisa kurang dari 1GB; pada bitrate saat ini cepat penuh — hentikan perekaman atau kosongkan ruang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno di 1 GB di spazio libero; con il bitrate attuale si saturerà presto: interrompi la registrazione o libera spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクの空き容量が 1GB 未満です。現在のビットレートではすぐ一杯になります。録音を停止するか空き容量を確保してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크 여유 공간이 1GB 미만입니다. 현재 비트레이트로는 곧 가득 찹니다. 녹음을 중지하거나 공간을 확보하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minder dan 1 GB schijfruimte vrij; bij de huidige bitrate raakt het snel vol — stop de opname of maak ruimte vrij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zostało mniej niż 1 GB miejsca; przy obecnym bitrate szybko się zapełni — zatrzymaj nagrywanie lub zwolnij miejsce."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menos de 1 GB de espaço livre; com o débito atual enche rapidamente — pare a gravação ou liberte espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Свободно менее 1 ГБ; при текущем битрейте место скоро закончится — остановите запись или освободите место."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindre än 1 GB ledigt; med nuvarande bitrate fylls det snart — stoppa inspelningen eller frigör utrymme."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่ดิสก์เหลือน้อยกว่า 1GB ที่บิตเรตปัจจุบันจะเต็มเร็ว โปรดหยุดบันทึกหรือลบไฟล์"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1GB’den az disk alanı kaldı; mevcut bit hızında kısa sürede dolar — kaydı durdurun veya yer açın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вільно менше 1 ГБ; за поточного бітрейту місце швидко закінчиться — зупиніть запис або звільніть місце."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Còn dưới 1GB dung lượng; với bitrate hiện tại sẽ đầy nhanh — hãy dừng ghi hoặc dọn dung lượng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘剩余空间不足 1GB，按当前码率较快写满，请尽快停止录音或清理磁盘。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟剩餘空間不足 1GB，按目前位元率會較快寫滿，請盡快停止錄音或清理磁碟。"
          }
        }
      }
    },
    "磁盘剩余空间不足 200MB（PCM 分片约 1GB/小时），已自动停止录音以保全已录内容。请清理磁盘后重新录制。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المساحة المتبقية على القرص أقل من 200 ميغابايت (تستهلك مقاطع PCM نحو 1 غيغابايت في الساعة). تم إيقاف التسجيل تلقائيًا للحفاظ على ما تم تسجيله. حرّر مساحة على القرص ثم ابدأ التسجيل من جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weniger als 200 MB freier Speicherplatz (PCM-Segmente belegen etwa 1 GB pro Stunde). Die Aufnahme wurde automatisch gestoppt, um das bereits Aufgezeichnete zu sichern. Schaffe Speicherplatz frei und starte eine neue Aufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Less than 200 MB of disk space left (PCM chunks use about 1 GB per hour). Recording was stopped automatically to preserve what has already been captured. Free up disk space and start a new recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quedan menos de 200 MB de espacio en disco (los segmentos PCM ocupan unos 1 GB por hora). La grabación se detuvo automáticamente para conservar lo ya capturado. Libera espacio en disco y vuelve a grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moins de 200 Mo d'espace disque disponible (les segments PCM occupent environ 1 Go par heure). L'enregistrement a été arrêté automatiquement pour préserver ce qui a déjà été capturé. Libérez de l'espace disque, puis relancez l'enregistrement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिस्क में 200MB से कम जगह बची है (PCM खंड लगभग 1GB/घंटा लेते हैं)। पहले से रिकॉर्ड की गई सामग्री बचाने के लिए रिकॉर्डिंग स्वतः रोक दी गई है। डिस्क खाली करके दोबारा रिकॉर्ड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang disk tersisa kurang dari 200 MB (potongan PCM memakan sekitar 1 GB per jam). Perekaman dihentikan otomatis untuk menjaga apa yang sudah terekam. Kosongkan ruang disk lalu rekam ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meno di 200 MB di spazio su disco disponibile (i segmenti PCM occupano circa 1 GB all'ora). La registrazione è stata interrotta automaticamente per preservare quanto già acquisito. Libera spazio su disco e registra di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクの空き容量が 200MB 未満です（PCM チャンクは 1 時間あたり約 1GB）。録音済みの内容を保護するため録音を自動停止しました。ディスクを空けてから録音し直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스크 여유 공간이 200MB 미만입니다(PCM 청크는 시간당 약 1GB). 이미 녹음된 내용을 보호하기 위해 녹음을 자동으로 중지했습니다. 디스크를 정리한 후 다시 녹음하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minder dan 200 MB schijfruimte over (PCM-fragmenten gebruiken ongeveer 1 GB per uur). De opname is automatisch gestopt om het al opgenomen materiaal te behouden. Maak schijfruimte vrij en neem opnieuw op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mniej niż 200 MB wolnego miejsca na dysku (fragmenty PCM zajmują około 1 GB na godzinę). Nagrywanie zostało automatycznie zatrzymane, aby zachować już zarejestrowany materiał. Zwolnij miejsce na dysku i nagraj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restam menos de 200 MB de espaço em disco (os segmentos PCM ocupam cerca de 1 GB por hora). A gravação foi interrompida automaticamente para preservar o que já foi capturado. Libere espaço em disco e grave novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осталось менее 200 МБ свободного места (сегменты PCM занимают около 1 ГБ в час). Запись была остановлена автоматически, чтобы сохранить уже записанное. Освободите место на диске и начните запись заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindre än 200 MB ledigt diskutrymme kvar (PCM-segment tar cirka 1 GB per timme). Inspelningen stoppades automatiskt för att bevara det som redan spelats in. Frigör diskutrymme och spela in igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "พื้นที่ว่างบนดิสก์เหลือน้อยกว่า 200MB (ไฟล์ PCM ใช้ประมาณ 1GB ต่อชั่วโมง) ระบบหยุดบันทึกเสียงอัตโนมัติเพื่อรักษาสิ่งที่บันทึกไว้แล้ว โปรดเพิ่มพื้นที่ว่างบนดิสก์แล้วบันทึกใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk alanı 200 MB'ın altında (PCM parçaları saatte yaklaşık 1 GB). Kaydedilenleri korumak için kayıt otomatik olarak durduruldu. Diskte yer açıp yeniden kaydedin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Залишилося менше 200 МБ вільного місця (сегменти PCM займають близько 1 ГБ на годину). Запис автоматично зупинено, щоб зберегти вже записане. Звільніть місце на диску й почніть запис знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dung lượng trống trên đĩa còn dưới 200 MB (các đoạn PCM chiếm khoảng 1 GB mỗi giờ). Quá trình ghi âm đã tự động dừng để bảo toàn nội dung đã ghi. Hãy giải phóng dung lượng đĩa rồi ghi lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘剩余空间不足 200MB（PCM 分片约 1GB/小时），已自动停止录音以保全已录内容。请清理磁盘后重新录制。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟剩餘空間不足 200MB（PCM 分片約 1GB/小時），已自動停止錄音以保全已錄內容。請清理磁碟後重新錄製。"
          }
        }
      }
    },
    "磁盘可用空间不足：可用 %.1fGB，导入视频至少需要 %.1fGB（原片副本 + 音轨与余量）" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المساحة الحرة غير كافية: المتاح %.1fGB، بينما يحتاج استيراد الفيديو إلى %.1fGB على الأقل (نسخة من الأصل + المسار الصوتي وهامش)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht genügend freier Speicherplatz: %.1f GB verfügbar, der Videoimport braucht aber mindestens %.1f GB (Kopie des Originals + Audiospur und Reserve)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Not enough free disk space: %.1f GB available, but importing video needs at least %.1f GB (a copy of the original plus the audio track and headroom)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espacio libre insuficiente: %.1f GB disponibles, pero importar vídeo necesita al menos %.1f GB (copia del original + pista de audio y margen)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espace disque insuffisant : %.1f Go disponibles, alors que l’import vidéo nécessite au moins %.1f Go (copie de l’original + piste audio et marge)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खाली डिस्क स्थान अपर्याप्त: %.1fGB उपलब्ध, जबकि वीडियो आयात के लिए कम से कम %.1fGB चाहिए (मूल की प्रति + ऑडियो ट्रैक और अतिरिक्त जगह)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruang kosong tidak cukup: tersedia %.1fGB, sementara impor video butuh setidaknya %.1fGB (salinan asli + track audio dan cadangan)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spazio libero insufficiente: %.1f GB disponibili, ma l’importazione video richiede almeno %.1f GB (copia dell’originale + traccia audio e margine)."
