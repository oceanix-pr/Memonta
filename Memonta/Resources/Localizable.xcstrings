          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível extrair imagens utilizáveis do vídeo (fotogramas todos repetidos ou falha ao descodificar)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
