    "长会议（超过约 30 分钟）的说话人区分分段处理，进度会显示当前段号" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الاجتماعات الطويلة (أكثر من نحو 30 دقيقة) تُعالَج عملية تمييز المتحدثين على شكل مقاطع، ويُعرض رقم المقطع الحالي في شريط التقدّم"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei langen Besprechungen (über etwa 30 Minuten) wird die Sprechertrennung abschnittsweise verarbeitet; der Fortschritt zeigt den aktuellen Abschnitt"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For long meetings (over about 30 minutes) speaker separation is processed in segments, and the progress shows the current segment"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En reuniones largas (más de unos 30 minutos) la separación de hablantes se procesa por segmentos y el progreso muestra el segmento actual"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les réunions longues (plus d'environ 30 minutes), la séparation des locuteurs est traitée par segments et la progression indique le segment en cours"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लंबी मीटिंग (लगभग 30 मिनट से अधिक) में वक्ता पृथक्करण खंडों में संसाधित होता है और प्रगति में वर्तमान खंड संख्या दिखती है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk rapat panjang (lebih dari sekitar 30 menit), pemisahan pembicara diproses per segmen dan progres menampilkan nomor segmen saat ini"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle riunioni lunghe (oltre circa 30 minuti) la separazione degli interlocutori viene elaborata a segmenti e l'avanzamento mostra il segmento corrente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長時間の会議（約30分超）では話者分離を分割して処理し、進行状況に現在のセグメント番号を表示します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "긴 회의(약 30분 초과)는 화자 구분을 구간별로 처리하며, 진행 상황에 현재 구간 번호가 표시됩니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij lange vergaderingen (meer dan ongeveer 30 minuten) wordt de sprekersscheiding per segment verwerkt en toont de voortgang het huidige segmentnummer"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W długich spotkaniach (ponad około 30 minut) rozdzielanie mówców jest przetwarzane segmentami, a postęp pokazuje numer bieżącego segmentu"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em reuniões longas (mais de cerca de 30 minutos) a separação de falantes é processada por segmentos e o progresso mostra o segmento atual"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В длинных встречах (более примерно 30 минут) разделение говорящих обрабатывается по сегментам, а в ходе выполнения отображается номер текущего сегмента"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I långa möten (över cirka 30 minuter) bearbetas talaruppdelningen i segment och förloppet visar aktuellt segmentnummer"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การประชุมยาว (เกินประมาณ 30 นาที) จะแยกผู้พูดเป็นช่วง ๆ และแถบความคืบหน้าจะแสดงหมายเลขช่วงปัจจุบัน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzun toplantılarda (yaklaşık 30 dakikadan fazla) konuşmacı ayrımı bölümler hâlinde işlenir ve ilerleme çubuğu geçerli bölüm numarasını gösterir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У довгих зустрічах (понад приблизно 30 хвилин) розділення мовців обробляється сегментами, а в перебігу показується номер поточного сегмента"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với cuộc họp dài (hơn khoảng 30 phút), việc phân tách người nói được xử lý theo từng đoạn và tiến trình hiển thị số đoạn hiện tại"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长会议（超过约 30 分钟）的说话人区分分段处理，进度会显示当前段号"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "長會議（超過約 30 分鐘）的說話人區分分段處理，進度會顯示當前段號"
          }
        }
      }
    },
