        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型加载失败：%@。请检查模型文件夹内容是否完整"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型載入失敗：%@。請檢查模型資料夾內容是否完整"
          }
        }
      }
    },
    "模型加载超时。请确认模型文件夹所在磁盘/网络卷可访问、模型文件完整后重试。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت مهلة تحميل النموذج. تأكد من إمكانية الوصول إلى القرص أو وحدة الشبكة التي تضم مجلد النموذج ومن اكتمال ملفاته، ثم أعد المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitüberschreitung beim Laden des Modells. Prüfen Sie, ob der Datenträger bzw. das Netzwerkvolume mit dem Modellordner erreichbar und die Modelldateien vollständig sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model loading timed out. Make sure the disk or network volume holding the model folder is reachable and the model files are complete, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se agotó el tiempo de carga del modelo. Comprueba que el disco o volumen de red con la carpeta del modelo sea accesible y que los archivos estén completos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai dépassé lors du chargement du modèle. Vérifiez que le disque ou le volume réseau contenant le dossier du modèle est accessible et que les fichiers sont complets, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मॉडल लोड होने में समय समाप्त। जाँचें कि मॉडल फ़ोल्डर वाली डिस्क/नेटवर्क वॉल्यूम उपलब्ध है और मॉडल फ़ाइलें पूरी हैं, फिर कोशिश करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu memuat model habis. Pastikan disk atau volume jaringan berisi folder model dapat diakses dan file model lengkap, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeout durante il caricamento del modello. Verifica che il disco o il volume di rete con la cartella del modello sia accessibile e che i file siano completi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデルの読み込みがタイムアウトしました。モデルフォルダのあるディスク／ネットワークボリュームにアクセスでき、モデルファイルが揃っていることを確認して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델 로딩 시간 초과. 모델 폴더가 있는 디스크/네트워크 볼륨에 접근 가능하고 모델 파일이 온전한지 확인한 뒤 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdens het laden van het model is de tijd verstreken. Controleer of de schijf of netwerkvolume met de modelmap bereikbaar is en de bestanden compleet zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekroczono czas wczytywania modelu. Upewnij się, że dysk lub wolumen sieciowy z folderem modelu jest dostępny, a pliki modelu są kompletne."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A carga do modelo excedeu o tempo limite. Confirme que o disco ou volume de rede com a pasta do modelo está acessível e que os ficheiros estão completos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время загрузки модели истекло. Убедитесь, что диск или сетевой том с папкой модели доступен, а файлы модели целы, и повторите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidsgränsen för modelladdning överskreds. Kontrollera att disken eller nätverksvolymen med modellmappen är åtkomlig och att modellfilerna är kompletta."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โหลดโมเดลหมดเวลา โปรดตรวจสอบว่าดิสก์หรือโวลุ่มเครือข่ายที่มีโฟลเดอร์โมเดลเข้าถึงได้ และไฟล์โมเดลครบถ้วน แล้วลองใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Model yükleme zaman aşımına uğradı. Model klasörünün bulunduğu disk/ağ biriminin erişilebilir ve model dosyalarının eksiksiz olduğundan emin olup yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Час завантаження моделі вичерпано. Переконайтеся, що диск або мережевий том із текою моделі доступний, а файли моделі цілі, і повторіть."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hết thời gian tải mô hình. Hãy kiểm tra ổ đĩa/ổ mạng chứa thư mục mô hình có truy cập được và tệp mô hình đầy đủ, rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型加载超时。请确认模型文件夹所在磁盘/网络卷可访问、模型文件完整后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型載入逾時。請確認模型資料夾所在磁碟/網路卷可存取、模型檔案完整後重試。"
          }
        }
      }
    },
