    "截图保存为 PNG 原图（不加密），存储在文稿/Memonta 文件夹按月份归档" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحفظ لقطة الشاشة كصورة PNG أصلية (غير مشفّرة) في مجلد المستندات/Memonta، مرتبة حسب الشهر"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots werden als PNG-Original (unverschlüsselt) im Ordner Dokumente/Memonta gespeichert und nach Monat archiviert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshots are saved as original PNG (unencrypted) in the Documents/Memonta folder, archived by month"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las capturas se guardan como PNG original (sin cifrar) en la carpeta Documentos/Memonta, archivadas por mes"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les captures sont enregistrées en PNG original (non chiffré) dans le dossier Documents/Memonta, archivées par mois"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीनशॉट मूल PNG (बिना एन्क्रिप्ट) के रूप में दस्तावेज़/Memonta फ़ोल्डर में माह अनुसार संग्रहित होते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tangkapan layar disimpan sebagai PNG asli (tanpa enkripsi) di folder Dokumen/Memonta, diarsipkan per bulan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli screenshot sono salvati come PNG originale (non crittografato) nella cartella Documenti/Memonta, archiviati per mese"
          }
        },
        "ja" : {
          "stringUnit" : {
