    "点窗口红色关闭按钮只隐藏窗口不退出，可随时从菜单栏或 Dock 图标恢复" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "النقر على زر الإغلاق الأحمر للنافذة يخفيها فقط دون الخروج، ويمكن استعادتها في أي وقت من شريط القوائم أو أيقونة Dock"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Klick auf die rote Schließen-Schaltfläche des Fensters blendet es nur aus, ohne zu beenden; es kann jederzeit über die Menüleiste oder das Dock-Symbol wiederhergestellt werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicking the window's red close button only hides it without quitting; restore it anytime from the menu bar or Dock icon"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al hacer clic en el botón rojo de cerrar de la ventana solo se oculta sin salir; restáurela en cualquier momento desde la barra de menús o el icono del Dock"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquer sur le bouton rouge de fermeture de la fenêtre la masque seulement sans quitter ; restaurez-la à tout moment depuis la barre des menus ou l'icône du Dock"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विंडो के लाल बंद बटन पर क्लिक करने से वह केवल छिपती है, बंद नहीं होती; मेनू बार या Dock आइकन से कभी भी पुनर्प्राप्त करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengeklik tombol tutup merah jendela hanya menyembunyikannya tanpa keluar; pulihkan kapan saja dari bilah menu atau ikon Dock"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fare clic sul pulsante rosso di chiusura della finestra la nasconde soltanto senza uscire; ripristinala in qualsiasi momento dalla barra dei menu o dall'icona del Dock"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウの赤い閉じるボタンを押すと終了せずに隠すだけで、メニューバーや Dock アイコンからいつでも戻せます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "창의 빨간 닫기 버튼을 클릭하면 종료되지 않고 창만 숨겨지며, 메뉴 막대나 Dock 아이콘에서 언제든 복구할 수 있습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikken op de rode sluitknop van het venster verbergt het alleen zonder af te sluiten; herstel het op elk moment via de menubalk of het Dock-pictogram"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknięcie czerwonego przycisku zamykania okna tylko je ukrywa bez zamykania aplikacji; przywróć je w każdej chwili z paska menu lub ikony Docka"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clicar no botão vermelho de fechar da janela apenas a oculta sem sair; restaure-a a qualquer momento pela barra de menus ou pelo ícone do Dock"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щелчок по красной кнопке закрытия окна лишь скрывает его, не завершая работу; восстановите его в любой момент из строки меню или значка Dock"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att klicka på fönstrets röda stängknapp döljer det bara utan att avsluta; återställ det när som helst från menyraden eller Dock-ikonen"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การคลิกปุ่มปิดสีแดงของหน้าต่างจะซ่อนหน้าต่างโดยไม่ออกจากแอป กู้คืนได้ทุกเมื่อจากแถบเมนูหรือไอคอน Dock"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencerenin kırmızı kapat düğmesine tıklamak yalnızca pencereyi gizler, uygulamayı kapatmaz; menü çubuğundan veya Dock simgesinden istediğiniz zaman geri yükleyin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Клацання по червоній кнопці закриття вікна лише приховує його, не завершуючи роботу; відновіть його будь-коли з рядка меню або значка Dock"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấp nút đóng màu đỏ của cửa sổ chỉ ẩn cửa sổ chứ không thoát; khôi phục bất cứ lúc nào từ thanh menu hoặc biểu tượng Dock"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点窗口红色关闭按钮只隐藏窗口不退出，可随时从菜单栏或 Dock 图标恢复"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點視窗紅色關閉按鈕只隱藏視窗不退出，可隨時從選單列或 Dock 圖示恢復"
          }
        }
      }
    },
