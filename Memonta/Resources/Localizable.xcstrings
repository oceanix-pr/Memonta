          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hợp nhất âm thanh quá thời gian, xuất bị gián đoạn. Các tệp phân đoạn vẫn trong thư mục ghi và tự khôi phục sau khi làm mới."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音频合并超时，导出已被中断。分片文件已保留在录音文件夹，重新刷新后可自动恢复。"
