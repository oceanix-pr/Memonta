        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses birleştirme zaman aşımına uğradı, dışa aktarma kesildi. Bölüm dosyaları kayıt klasöründe duruyor ve yenilemede otomatik kurtarılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
