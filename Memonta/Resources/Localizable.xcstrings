          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบไฟล์การบันทึกไม่สำเร็จ: %@ รายการฐานข้อมูลถูกเก็บไว้เพื่อป้องกันข้อมูลกลับมา โปรดลบไฟล์ด้วยตนเองแล้วลองใหม่"
