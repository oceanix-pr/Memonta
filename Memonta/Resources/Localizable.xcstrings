      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل تنزيل نموذج فصل المتحدثين: %@. تحقق من الشبكة وأعد المحاولة، أو اتبع تعليمات صفحة الإعدادات لتنزيله يدويًا في مجلد النموذج."
          }
        },
        "de" : {
