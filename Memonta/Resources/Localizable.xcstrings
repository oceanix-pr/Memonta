    "开启后，左侧列表将显示被隐藏的录音与笔记（文字颜色较浅）。可在列表中右键取消隐藏。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التفعيل، تعرض القائمة اليسرى التسجيلات والملاحظات المخفية (بنص أفتح). يمكنك النقر بزر الماوس الأيمن في القائمة لإلغاء الإخفاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, zeigt die linke Liste ausgeblendete Aufnahmen und Notizen an (hellere Schrift). Per Rechtsklick in der Liste lässt sich die Ausblendung aufheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, the sidebar list shows hidden recordings and notes (displayed with lighter text). Right-click an item in the list to unhide it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al activarlo, la lista de la izquierda muestra las grabaciones y notas ocultas (texto más claro). Haz clic derecho en la lista para dejar de ocultarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois activé, la liste de gauche affiche les enregistrements et notes masqués (texte plus clair). Faites un clic droit dans la liste pour les afficher à nouveau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सक्षम करने पर, बाईं ओर की सूची में छिपी रिकॉर्डिंग और नोट्स दिखते हैं (हल्के रंग के पाठ में)। सूची में राइट-क्लिक करके छिपाना हटा सकते हैं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika diaktifkan, daftar di kiri menampilkan rekaman dan catatan tersembunyi (teks lebih terang). Klik kanan pada item di daftar untuk membatalkan penyembunyian."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una volta attivato, l'elenco a sinistra mostra registrazioni e note nascoste (testo più chiaro). Fai clic destro nell'elenco per rimuoverle dalla modalità nascosta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効にすると、左側のリストに非表示の録音とメモが表示されます（文字は薄色で表示）。リスト内で右クリックして非表示を解除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "활성화하면 왼쪽 목록에 숨긴 녹음과 메모가 표시됩니다(텍스트 색상이 더 옅음). 목록에서 오른쪽 클릭으로 숨기기를 해제할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien ingeschakeld, toont de linkerlijst verborgen opnamen en notities (lichtere tekst). Klik met de rechtermuisknop in de lijst om ze weer zichtbaar te maken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po włączeniu lista po lewej stronie pokazuje ukryte nagrania i notatki (jaśniejszy tekst). Kliknij prawym przyciskiem na liście, aby cofnąć ukrycie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando ativado, a lista à esquerda mostra gravações e notas ocultas (texto mais claro). Clique com o botão direito na lista para exibir novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если включено, в списке слева отображаются скрытые записи и заметки (более светлый текст). Щёлкните правой кнопкой мыши в списке, чтобы снять скрытие."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När aktiverat visas dolda inspelningar och anteckningar i listan till vänster (ljusare text). Högerklicka i listan för att ta bort döljandet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เมื่อเปิดใช้ รายการด้านซ้ายจะแสดงเสียงบันทึกและโน้ตที่ซ่อน (ตัวอักษรสีจางลง) คลิกขวาในรายการเพื่อยกเลิกการซ่อน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etkinleştirildiğinde, soldaki liste gizli kayıtları ve notları gösterir (daha açık renkli metin). Listede sağ tıklayarak gizliliği kaldırabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Якщо увімкнено, у списку ліворуч відображаються приховані записи та нотатки (світліший текст). Клацніть правою кнопкою миші у списку, щоб зняти приховування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bật, danh sách bên trái sẽ hiện các bản ghi âm và ghi chú đã ẩn (chữ màu nhạt hơn). Nhấp chuột phải trong danh sách để bỏ ẩn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启后，左侧列表将显示被隐藏的录音与笔记（文字颜色较浅）。可在列表中右键取消隐藏。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開啟後，左側列表將顯示被隱藏的錄音與筆記（文字顏色較淺）。可在列表中按右鍵取消隱藏。"
          }
        }
      }
    },
    "开启后，当系统输入设备被静音时（如会议软件调用系统级静音），自动暂停麦克风采集。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند التفعيل، يتوقف التقاط الميكروفون تلقائيًا عند كتم جهاز الإدخال في النظام (مثلًا عندما يستخدم تطبيق الاجتماع كتم النظام)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, wird die Mikrofonerfassung automatisch pausiert, wenn das Systemeingabegerät stummgeschaltet ist (z. B. wenn eine Meeting-App die Systemstummschaltung nutzt)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When enabled, microphone capture pauses automatically when the system input device is muted (e.g. when a meeting app uses system-level mute)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si se activa, la captura del micrófono se pausa automáticamente cuando el dispositivo de entrada del sistema está silenciado (p. ej., cuando una app de reunión usa el silencio del sistema)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
