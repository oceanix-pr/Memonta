          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिकॉर्डिंग फ़ोल्डर हटाने में विफल: %@। डेटा पुनः प्रकट होने से रोकने के लिए डेटाबेस प्रविष्टि रखी गई है। कृपया फ़ोल्डर मैन्युअल रूप से हटाकर पुनः प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal menghapus folder rekaman: %@. Entri basis data dipertahankan untuk mencegah data muncul kembali. Silakan hapus folder secara manual lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
