        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể giải mã tệp này trên máy này: có thể tệp được xuất từ Mac khác hoặc đã hỏng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
