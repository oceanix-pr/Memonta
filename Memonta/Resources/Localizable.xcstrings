        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt dosyası silinemedi: %@. Verilerin yeniden ortaya çıkmasını önlemek için veritabanı girişi korundu. Lütfen dosyayı manuel silip tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося видалити файл запису: %@. Запис бази даних збережено, щоб запобігти повторній появі даних. Видаліть файл вручну та спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
