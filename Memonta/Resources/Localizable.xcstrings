          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De toestemming voor spraakherkenning is niet verleend. Sta Memonta toe onder “Systeeminstellingen → Privacy en beveiliging → Spraakherkenning” en probeer het opnieuw."
