    "画面分析被意外中断，请重试（已完成的部分会保留）。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت مقاطعة تحليل الصور بشكل غير متوقع. أعد المحاولة (سيتم الاحتفاظ بالجزء المكتمل)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bildanalyse wurde unerwartet unterbrochen. Bitte erneut versuchen (der bereits fertige Teil bleibt erhalten)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visual analysis was interrupted unexpectedly. Please try again (completed parts are kept)."
          }
