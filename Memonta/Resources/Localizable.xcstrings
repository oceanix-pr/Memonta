    "不同意将退出 Memonta，且未同意前无法使用录音、转写与总结功能。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذا رفضت، سيُغلق Memonta، ولن يتوفر التسجيل والنسخ والتلخيص حتى الموافقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Ablehnung wird Memonta beendet; Aufnahme, Transkription und Zusammenfassung bleiben bis zur Zustimmung gesperrt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you decline, Memonta will quit, and recording, transcription and summarization stay unavailable until you agree."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si rechazas, Memonta se cerrará y no podrás usar grabación, transcripción ni resumen hasta que aceptes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En cas de refus, Memonta se fermera ; l’enregistrement, la transcription et le résumé resteront indisponibles jusqu’à votre accord."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अस्वीकार करने पर Memonta बंद हो जाएगा, और सहमति देने तक रिकॉर्डिंग, ट्रांसक्रिप्शन व सारांश उपलब्ध नहीं रहेंगे।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jika menolak, Memonta akan keluar dan perekaman, transkripsi, serta ringkasan tidak tersedia sampai Anda menyetujui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rifiuti, Memonta si chiuderà e registrazione, trascrizione e riepilogo resteranno non disponibili finché non accetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同意しない場合、Memonta は終了し、同意するまで録音・文字起こし・要約は利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동의하지 않으면 Memonta가 종료되며, 동의하기 전에는 녹음·받아쓰기·요약 기능을 사용할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij weigeren sluit Memonta af; opnemen, transcriberen en samenvatten blijven onbeschikbaar tot je akkoord gaat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W razie odrzucenia Memonta zostanie zamknięty; nagrywanie, transkrypcja i podsumowania będą niedostępne do czasu akceptacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se recusar, o Memonta fecha e gravação, transcrição e resumo ficam indisponíveis até aceitar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При отказе Memonta закроется; запись, расшифровка и конспекты будут недоступны до согласия."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om du avböjer avslutas Memonta och inspelning, transkribering och sammanfattning är otillgängliga tills du godkänner."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากปฏิเสธ Memonta จะปิดลง และจะใช้การบันทึก ถอดเสียง และสรุปไม่ได้จนกว่าจะยอมรับ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reddederseniz Memonta kapanır; kabul edene kadar kayıt, yazıya dökme ve özetleme kullanılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У разі відмови Memonta закриється; запис, транскрипція та підсумки будуть недоступні до згоди."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nếu từ chối, Memonta sẽ thoát và bạn không thể dùng ghi âm, chuyển lời và tóm tắt cho đến khi đồng ý."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不同意将退出 Memonta，且未同意前无法使用录音、转写与总结功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不同意將結束 Memonta，且未同意前無法使用錄音、轉寫與總結功能。"
          }
        }
      }
    },
