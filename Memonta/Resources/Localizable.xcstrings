    "缺少屏幕录制权限，请在「系统设置 → 隐私与安全性 → 屏幕录制」中允许 Memonta。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إذن تسجيل الشاشة مفقود. اسمح لـ Memonta من «إعدادات النظام → الخصوصية والأمان → تسجيل الشاشة»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Berechtigung „Bildschirmaufnahme“ fehlt. Erlauben Sie Memonta unter Systemeinstellungen → Datenschutz & Sicherheit → Bildschirmaufnahme."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Recording permission is missing. Allow Memonta in System Settings → Privacy & Security → Screen Recording."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta el permiso de grabación de pantalla. Permite Memonta en Ajustes del Sistema → Privacidad y seguridad → Grabación de pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’autorisation d’enregistrement d’écran est manquante. Autorisez Memonta dans Réglages → Confidentialité et sécurité → Enregistrement de l’écran."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्क्रीन रिकॉर्डिंग की अनुमति नहीं है। «सिस्टम सेटिंग्स → गोपनीयता और सुरक्षा → स्क्रीन रिकॉर्डिंग» में Memonta को अनुमति दें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izin perekaman layar belum ada. Izinkan Memonta di «Pengaturan Sistem → Privasi & Keamanan → Perekaman Layar»."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manca il permesso di registrazione schermo. Consenti Memonta in Impostazioni di Sistema → Privacy e sicurezza → Registrazione schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面収録の権限がありません。「システム設定 → プライバシーとセキュリティ → 画面収録」で Memonta を許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "화면 기록 권한이 없습니다. ‘시스템 설정 → 개인정보 보호 및 보안 → 화면 기록’에서 Memonta를 허용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De machtiging Schermopname ontbreekt. Sta Memonta toe via Systeeminstellingen → Privacy en beveiliging → Schermopname."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brak uprawnienia do nagrywania ekranu. Zezwól aplikacji Memonta w „Ustawienia systemowe → Prywatność i bezpieczeństwo → Nagrywanie ekranu”."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falta a permissão de gravação de ecrã. Permita o Memonta em Definições do Sistema → Privacidade e Segurança → Gravação de ecrã."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет разрешения на запись экрана. Разрешите Memonta в «Системные настройки → Конфиденциальность и безопасность → Запись экрана»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behörigheten för skärminspelning saknas. Tillåt Memonta i Systeminställningar → Integritet och säkerhet → Skärminspelning."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ยังไม่ได้ให้สิทธิ์บันทึกหน้าจอ โปรดอนุญาต Memonta ที่ «การตั้งค่าระบบ → ความเป็นส่วนตัวและความปลอดภัย → การบันทึกหน้าจอ»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran kaydı izni yok. «Sistem Ayarları → Gizlilik ve Güvenlik → Ekran Kaydı» bölümünde Memonta’ya izin verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немає дозволу на запис екрана. Дозвольте Memonta у «Системні налаштування → Конфіденційність і безпека → Запис екрана»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiếu quyền ghi màn hình. Hãy cho phép Memonta trong «Cài đặt hệ thống → Quyền riêng tư và bảo mật → Ghi màn hình»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺少屏幕录制权限，请在「系统设置 → 隐私与安全性 → 屏幕录制」中允许 Memonta。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缺少螢幕錄製權限，請在「系統設定 → 隱私權與安全性 → 螢幕錄製」中允許 Memonta。"
          }
        }
      }
    },
    "缺少系统权限，请在系统设置中授权后重试。" : {
