    "网络连接不可用或无法连接服务器，请检查网络后重试。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشبكة غير متاحة أو يتعذّر الوصول إلى الخادم. تحقق من الاتصال وأعد المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Netzwerk ist nicht verfügbar oder der Server ist nicht erreichbar. Prüfen Sie die Verbindung und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The network is unavailable or the server can't be reached. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La red no está disponible o no se puede alcanzar el servidor. Comprueba la conexión e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le réseau est indisponible ou le serveur est injoignable. Vérifiez votre connexion et réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नेटवर्क उपलब्ध नहीं है या सर्वर तक नहीं पहुँचा जा सकता। कनेक्शन जाँचें और पुनः प्रयास करें।"
