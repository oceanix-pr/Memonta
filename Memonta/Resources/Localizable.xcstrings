    "试听该说话人最早的一段，便于判断是谁" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استمع إلى أول مقطع لهذا المتحدث لتسهيل تحديد هويته"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den frühesten Abschnitt dieses Sprechers anhören, um ihn leichter zuzuordnen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preview this speaker’s earliest segment to help tell who it is"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escuchar el primer fragmento de este hablante para ayudarte a identificarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écouter le premier passage de cet interlocuteur pour aider à l'identifier"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह कौन है यह पहचानने में मदद के लिए इस वक्ता का सबसे पहला खंड सुनें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dengarkan segmen paling awal pembicara ini untuk membantu mengenali siapa dia"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ascolta il primo frammento di questo interlocutore per aiutarti a identificarlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この話者の最初の発話を試聴して、誰かを判断しやすくします"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 화자의 가장 이른 구간을 미리 들어 누구인지 판단하기 쉽게 합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beluister het vroegste fragment van deze spreker om te helpen bepalen wie het is"
