    "只删除原始视频文件，关键帧与画面要点保留" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف ملف الفيديو الأصلي فقط، مع الاحتفاظ بالإطارات الرئيسية والملاحظات المرئية"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht nur die Originalvideodatei; Keyframes und visuelle Notizen bleiben erhalten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only deletes the original video file; keyframes and visual notes are kept"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina solo el archivo de vídeo original; los fotogramas clave y las notas visuales se conservan"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime uniquement le fichier vidéo d'origine ; les images clés et le résumé visuel sont conservés"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल मूल वीडियो फ़ाइल हटाता है; कीफ़्रेम और दृश्य नोट्स सुरक्षित रहते हैं"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya menghapus file video asli; keyframe dan catatan visual tetap disimpan"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina solo il file video originale; fotogrammi chiave e note visive vengono conservati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元の動画ファイルだけを削除し、キーフレームと画面メモは保持します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 동영상 파일만 삭제하고 키프레임과 화면 요약은 유지됩니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert alleen het originele videobestand; keyframes en visuele notities blijven bewaard"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa tylko oryginalny plik wideo; klatki kluczowe i notatki wizualne pozostają"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina apenas o ficheiro de vídeo original; os fotogramas-chave e as notas visuais são mantidos"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет только исходный видеофайл; ключевые кадры и визуальные заметки сохраняются"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bara bort originalvideofilen; nyckelbildrutor och visuella anteckningar behålls"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบเฉพาะไฟล์วิดีโอต้นฉบับ โดยคีย์เฟรมและบันทึกภาพยังคงอยู่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca orijinal video dosyasını siler; kare ve görsel notlar korunur"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляє лише оригінальний відеофайл; ключові кадри та візуальні нотатки зберігаються"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ xóa tệp video gốc; khung hình chính và ghi chú hình ảnh vẫn được giữ"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只删除原始视频文件，关键帧与画面要点保留"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只刪除原始影片檔案，關鍵影格與畫面要點保留"
          }
        }
      }
    },
    "只删除原始视频文件（约 %@），释放空间。关键帧 %d 张、画面要点、转写与总结全部保留。清理后无法重新抽取关键帧。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحذف ملف الفيديو الأصلي فقط (نحو %1$@) لتحرير المساحة. تُحتفظ بالإطارات الرئيسية (%2$d) والملاحظات المرئية والنص والملخص. وبعد التنظيف لا يمكن استخراج الإطارات الرئيسية مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Löscht nur die Originalvideodatei (ca. %1$@), um Speicher freizugeben. Keyframes (%2$d), visuelle Notizen, Transkript und Zusammenfassung bleiben erhalten. Nach dem Aufräumen können keine Keyframes mehr extrahiert werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes only the original video file (about %1$@) to free up space. Keyframes (%2$d), visual notes, transcript and summary are all kept. After cleanup, keyframes can no longer be extracted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina solo el archivo de vídeo original (unos %1$@) para liberar espacio. Los fotogramas clave (%2$d), las notas visuales, la transcripción y el resumen se conservan. Tras la limpieza no se pueden volver a extraer fotogramas clave."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprime uniquement le fichier vidéo d'origine (environ %1$@) pour libérer de l'espace. Les images clés (%2$d), le résumé visuel, la transcription et le résumé sont tous conservés. Après nettoyage, les images clés ne peuvent plus être extraites."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल मूल वीडियो फ़ाइल (लगभग %1$@) हटाकर जगह खाली करता है। कीफ़्रेम %2$d, दृश्य नोट्स, ट्रांसक्रिप्ट और सारांश सब सुरक्षित रहते हैं। सफ़ाई के बाद कीफ़्रेम दोबारा नहीं निकाले जा सकते।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya menghapus file video asli (sekitar %1$@) untuk mengosongkan ruang. Keyframe %2$d, catatan visual, transkripsi, dan ringkasan semuanya tetap disimpan. Setelah dibersihkan, keyframe tidak dapat diekstrak lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina solo il file video originale (circa %1$@) per liberare spazio. Fotogrammi chiave (%2$d), note visive, trascrizione e riepilogo vengono tutti conservati. Dopo la pulizia non è più possibile estrarre i fotogrammi chiave."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元の動画ファイル（約 %1$@）だけを削除して容量を空けます。キーフレーム %2$d 枚、画面メモ、文字起こしと要約はすべて保持されます。整理後はキーフレームを再抽出できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원본 동영상 파일(약 %1$@)만 삭제해 공간을 확보합니다. 키프레임 %2$d개, 화면 요약, 전사와 요약은 모두 유지됩니다. 정리 후에는 키프레임을 다시 추출할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijdert alleen het originele videobestand (ongeveer %1$@) om ruimte vrij te maken. Keyframes (%2$d), visuele notities, transcriptie en samenvatting blijven allemaal bewaard. Na het opruimen kunnen keyframes niet opnieuw worden geëxtraheerd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usuwa tylko oryginalny plik wideo (około %1$@), aby zwolnić miejsce. Klatki kluczowe (%2$d), notatki wizualne, transkrypcja i podsumowanie pozostają. Po wyczyszczeniu nie można ponownie wyodrębnić klatek kluczowych."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina apenas o ficheiro de vídeo original (cerca de %1$@) para libertar espaço. Os fotogramas-chave (%2$d), as notas visuais, a transcrição e o resumo são todos mantidos. Após a limpeza, já não é possível extrair fotogramas-chave."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляется только исходный видеофайл (около %1$@), чтобы освободить место. Ключевые кадры (%2$d), визуальные заметки, расшифровка и резюме сохраняются. После очистки извлечь ключевые кадры заново нельзя."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tar bara bort originalvideofilen (cirka %1$@) för att frigöra utrymme. %2$d nyckelbildrutor, visuella anteckningar, transkribering och sammanfattning behålls. Efter rensning kan nyckelbildrutor inte extraheras igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบเฉพาะไฟล์วิดีโอต้นฉบับ (ประมาณ %1$@) เพื่อคืนพื้นที่ โดยยังคงคีย์เฟรม %2$d รายการ บันทึกภาพ ข้อความถอดความ และสรุปไว้ทั้งหมด หลังล้างแล้วจะแยกคีย์เฟรมซ้ำไม่ได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca orijinal video dosyasını (yaklaşık %1$@) silerek yer açar. %2$d kare, görsel notlar, çeviri yazı ve özet korunur. Temizlemeden sonra kareler yeniden çıkarılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видаляється лише оригінальний відеофайл (близько %1$@), щоб звільнити місце. Ключові кадри (%2$d), візуальні нотатки, транскрипція й підсумок залишаються. Після очищення повторно видобути ключові кадри не можна."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ xóa tệp video gốc (khoảng %1$@) để giải phóng dung lượng. Khung hình chính %2$d, ghi chú hình ảnh, bản chuyển ngữ và tóm tắt đều được giữ lại. Sau khi dọn, không thể trích xuất lại khung hình chính."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只删除原始视频文件（约 %1$@），释放空间。关键帧 %2$d 张、画面要点、转写与总结全部保留。清理后无法重新抽取关键帧。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只刪除原始影片檔案（約 %1$@），釋放空間。關鍵影格 %2$d 張、畫面要點、轉寫與總結全部保留。清理後無法重新擷取關鍵影格。"
          }
        }
      }
    },
    "只需告诉 Memonta 会议在线上还是同一空间进行，应用会自动选择合适的录音方式。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبِر Memonta فقط ما إذا كان الاجتماع عبر الإنترنت أم في المساحة نفسها، وسيختار التطبيق طريقة التسجيل المناسبة تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sagen Sie Memonta einfach, ob die Sitzung online oder im selben Raum stattfindet, und die App wählt automatisch die passende Aufnahmemethode."
