        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie przyznano uprawnienia do rozpoznawania mowy. Zezwól aplikacji Memonta w „Ustawienia systemowe → Prywatność i bezpieczeństwo → Rozpoznawanie mowy” i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
