          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音フォルダの削除に失敗: %@。データの復活を防ぐためデータベースの記録は保持しました。フォルダを手動で削除してから再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음 폴더 삭제 실패: %@. 데이터 부활을 막기 위해 데이터베이스 기록은 유지했습니다. 폴더를 수동으로 삭제한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnamemap verwijderen mislukt: %@. Het database-item is behouden om het opnieuw verschijnen van gegevens te voorkomen. Verwijder de map handmatig en probeer opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się usunąć folderu nagrania: %@. Wpis bazy danych został zachowany, aby zapobiec ponownemu pojawieniu się danych. Usuń folder ręcznie i spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
