    "录音/录屏进行中，请先停止后再开始录屏" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هناك تسجيل صوتي أو تسجيل شاشة جارٍ؛ أوقفه قبل بدء تسجيل شاشة جديد"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio- oder Bildschirmaufnahme läuft; bitte zuerst stoppen, dann eine neue Bildschirmaufnahme starten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Audio or screen recording is in progress; stop it before starting a new screen recording"
          }
        },
        "es" : {
