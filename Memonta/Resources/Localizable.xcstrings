    "仍有后台任务待处理，请等队列清空后再更改数据文件夹。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تزال هناك مهام في الخلفية قيد الانتظار. انتظر حتى يفرغ الطابور قبل تغيير مجلد البيانات."
          }
