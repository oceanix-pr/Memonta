          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось удалить папку записи: %@. Запись в базе данных сохранена, чтобы предотвратить повторное появление данных. Удалите папку вручную и повторите попытку."
          }
        },
        "sv" : {
