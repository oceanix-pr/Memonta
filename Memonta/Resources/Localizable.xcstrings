    "首次启动会执行加密迁移，旧数据自动升级" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في أول تشغيل تُنفذ ترحيلة تشفير وتُحدّث البيانات القديمة تلقائيًا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim ersten Start wird eine Verschlüsselungsmigration ausgeführt; alte Daten werden automatisch aktualisiert"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On first launch, an encryption migration runs and old data is upgraded automatically"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
