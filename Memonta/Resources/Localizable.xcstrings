    "选中录音后，点击工具栏「转写」按钮开始语音识别" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد اختيار تسجيل، انقر «تفريغ» في شريط الأدوات لبدء التعرف على الكلام"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach Auswahl einer Aufnahme klicken Sie auf „Transkribieren“ in der Symbolleiste, um die Spracherkennung zu starten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After selecting a recording, click \"Transcribe\" in the toolbar to start speech recognition"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tras seleccionar una grabación, pulsa «Transcribir» en la barra de herramientas para iniciar el reconocimiento de voz"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après avoir sélectionné un enregistrement, cliquez sur « Transcrire » dans la barre d'outils pour lancer la reconnaissance vocale"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिकॉर्डिंग चुनने के बाद, वाक् पहचान शुरू करने के लिए टूलबार के «ट्रांसक्राइब» बटन पर क्लिक करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setelah memilih rekaman, klik «Transkripsi» di bilah alat untuk memulai pengenalan suara"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo aver selezionato una registrazione, premi «Trascrivi» nella barra strumenti per avviare il riconoscimento vocale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音を選択したら、ツールバーの「文字起こし」ボタンで音声認識を開始します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음을 선택한 후 도구 막대의 '전사' 버튼으로 음성 인식을 시작하세요"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik na het selecteren van een opname op «Transcribeer» in de knoppenbalk om spraakherkenning te starten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po wybraniu nagrania kliknij «Transkrybuj» na pasku narzędzi, aby rozpocząć rozpoznawanie mowy"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Após selecionar uma gravação, clique em «Transcrever» na barra de ferramentas para iniciar o reconhecimento de voz"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбрав запись, нажмите «Расшифровать» на панели инструментов, чтобы запустить распознавание речи"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efter att ha valt en inspelning, klicka på «Transkribera» i verktygsfältet för att starta taligenkänning"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หลังจากเลือกการบันทึก คลิก «ถอดความ» ในแถบเครื่องมือเพื่อเริ่มการรู้จำเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir kayıt seçtikten sonra, konuşma tanımayı başlatmak için araç çubuğundaki «Çeviri yaz»a tıklayın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибравши запис, клацніть «Транскрибувати» на панелі інструментів, щоб почати розпізнавання мовлення"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sau khi chọn bản ghi, nhấp «Chuyển ngữ» trên thanh công cụ để bắt đầu nhận dạng giọng nói"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选中录音后，点击工具栏「转写」按钮开始语音识别"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選中錄音後，點擊工具列「轉寫」按鈕開始語音識別"
          }
        }
      }
    },
    "选中的录音与快捷笔记及其文件和待办将一并删除，删除后无法恢复。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم حذف التسجيلات والملاحظات السريعة المحددة مع ملفاتها ومهامها معًا. لا يمكن التراجع عن الحذف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgewählten Aufnahmen und Notizen werden zusammen mit ihren Dateien und To-dos gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected recordings and quick notes, along with their files and to-dos, will be deleted together. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las grabaciones y notas rápidas seleccionadas se eliminarán junto con sus archivos y tareas. No se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les enregistrements et notes rapides sélectionnés seront supprimés, ainsi que leurs fichiers et tâches. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चयनित रिकॉर्डिंग और त्वरित नोट अपनी फ़ाइलों व कार्यों सहित हटा दिए जाएँगे। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rekaman dan catatan cepat yang dipilih akan dihapus beserta berkas dan tugasnya. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le registrazioni e le note rapide selezionate verranno eliminate insieme ai relativi file e attività. L’operazione è irreversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した録音とクイックノートは、ファイルと To-Do ごと削除されます。削除後は元に戻せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 녹음과 빠른 노트가 파일과 할 일까지 함께 삭제됩니다. 삭제 후에는 되돌릴 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De geselecteerde opnamen en snelle notities worden samen met hun bestanden en taken verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane nagrania i szybkie notatki zostaną usunięte wraz z plikami i zadaniami. Tej operacji nie można cofnąć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As gravações e notas rápidas selecionadas serão eliminadas juntamente com os respetivos ficheiros e tarefas. Não é possível anular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранные записи и быстрые заметки будут удалены вместе с файлами и задачами. Отменить это нельзя."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De markerade inspelningarna och snabanteckningarna tas bort tillsammans med filer och uppgifter. Det går inte att ångra."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การบันทึกและโน้ตด่วนที่เลือกจะถูกลบพร้อมไฟล์และรายการงาน ไม่สามารถกู้คืนได้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçili kayıtlar ve hızlı notlar, dosyaları ve yapılacaklarıyla birlikte silinecek. Bu işlem geri alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибрані записи та швидкі нотатки буде видалено разом з їхніми файлами й завданнями. Скасувати це неможливо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Các bản ghi và ghi chú nhanh đã chọn sẽ bị xóa cùng tệp và việc cần làm. Không thể hoàn tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选中的录音与快捷笔记及其文件和待办将一并删除，删除后无法恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取的錄音與快捷筆記及其檔案和待辦將一併刪除，刪除後無法恢復。"
          }
        }
      }
    },
