        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use la herramienta de selección para hacer clic y seleccionar anotaciones individuales; admite mover, eliminar (tecla Delete) y modificar propiedades"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez l'outil de sélection pour cliquer et sélectionner des annotations individuelles ; prend en charge le déplacement, la suppression (touche Delete) et la modification des propriétés"
          }
        },
        "hi" : {
          "stringUnit" : {
