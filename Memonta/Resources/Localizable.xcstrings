          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extraherar representativa bildrutor och registrerar bildspel, dokument, kod och delade skärmar längs videons tidslinje; vid ny analys återanvänds befintliga bildrutor."
