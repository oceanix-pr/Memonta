    "如有隐私相关问题，请通过应用内「用户反馈」功能联系我们。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للاستفسارات المتعلقة بالخصوصية، تواصل معنا عبر ميزة «ملاحظات المستخدم» في التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei Fragen zum Datenschutz kontaktieren Sie uns bitte über die In-App-Funktion „Nutzer-Feedback“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For privacy-related questions, please contact us via the in-app Feedback feature."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para consultas sobre privacidad, contáctanos mediante la función «Comentarios del usuario» de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour toute question de confidentialité, contactez-nous via la fonction « Feedback utilisateur » de l'app."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "गोपनीयता से जुड़े प्रश्नों के लिए, ऐप के «उपयोगकर्ता प्रतिक्रिया» फ़ीचर से संपर्क करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk pertanyaan privasi, hubungi kami melalui fitur «Umpan Balik Pengguna» di aplikasi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per domande sulla privacy, contattaci tramite la funzione «Feedback utente» dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシーに関するご質問は、アプリ内の「ユーザーフィードバック」からお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인정보 관련 문의는 앱 내 '사용자 피드백' 기능으로 연락해 주세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor privacyvragen kunt u contact opnemen via de functie «Gebruikersfeedback» in de app."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W sprawach prywatności skontaktuj się z nami przez funkcję «Opinie użytkowników» w aplikacji."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para dúvidas sobre privacidade, fale conosco pelo recurso «Feedback do usuário» do app."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По вопросам конфиденциальности свяжитесь с нами через функцию «Отзыв пользователя» в приложении."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För integritetsfrågor, kontakta oss via funktionen «Användarfeedback» i appen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับคำถามเรื่องความเป็นส่วนตัว ติดต่อเราผ่านฟีเจอร์ «ข้อเสนอแนะผู้ใช้» ในแอป"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizlilik soruları için uygulama içi «Kullanıcı Geri Bildirimi» özelliğinden bize ulaşın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для запитань щодо конфіденційності зв'яжіться з нами через функцію «Відгук користувача» в застосунку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Với câu hỏi về quyền riêng tư, hãy liên hệ qua tính năng «Phản hồi người dùng» trong ứng dụng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
