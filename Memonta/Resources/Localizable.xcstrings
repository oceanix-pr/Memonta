          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-คลิก หรือ ⇧-คลิก เพื่อเลือกหลายรายการ; คลิกขวาเพื่อซ่อนหรือลบเป็นชุด"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Birden çok seçmek için ⌘-tık veya ⇧-tık; toplu gizlemek veya silmek için sağ tık"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-клацання або ⇧-клацання для вибору кількох; клацання правою для масового приховування чи видалення"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⌘-nhấp hoặc ⇧-nhấp để chọn nhiều mục; nhấp phải để ẩn hoặc xóa hàng loạt"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 ⌘ 或 ⇧ 点击可多选；右键可批量隐藏或删除"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住 ⌘ 或 ⇧ 點擊可多選；右鍵可批次隱藏或刪除"
          }
        }
      }
    },
