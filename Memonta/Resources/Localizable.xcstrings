          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyodrębnia reprezentatywne klatki i zapisuje slajdy, dokumenty, kod oraz udostępniane ekrany na osi czasu; ponowna analiza wykorzystuje istniejące klatki."
          }
        },
        "pt" : {
          "stringUnit" : {
