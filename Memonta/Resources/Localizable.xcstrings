            "value" : "वीडियो से उपयोगी फ़्रेम नहीं निकाले जा सके (सभी फ़्रेम दोहराव वाले या डिकोड विफल)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidak dapat mengekstrak frame yang berguna dari video (semua frame duplikat atau gagal didekode)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile estrarre immagini utilizzabili (fotogrammi tutti duplicati o decodifica non riuscita)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画から有効な画面を抽出できませんでした（抽出したフレームがすべて重複かデコード失敗）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상에서 사용할 수 있는 화면을 추출하지 못했습니다(추출된 프레임이 모두 중복이거나 디코딩 실패)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er konden geen bruikbare beelden uit de video worden gehaald (alle frames dubbel of decodering mislukt)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
