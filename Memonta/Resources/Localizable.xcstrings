    "目标文件夹不可创建或不可写入，请检查权限与磁盘空间后重试。" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر إنشاء المجلد الهدف أو الكتابة فيه. تحقق من الأذونات ومساحة القرص ثم أعد المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Zielordner kann nicht erstellt oder beschrieben werden. Prüfen Sie Berechtigungen und Speicherplatz und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The target folder cannot be created or written to. Check permissions and disk space, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede crear ni escribir en la carpeta de destino. Comprueba los permisos y el espacio en disco e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de créer ou d'écrire dans le dossier cible. Vérifiez les autorisations et l'espace disque, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लक्ष्य फ़ोल्डर बनाया या लिखा नहीं जा सकता। अनुमतियाँ और डिस्क स्थान जाँचें, फिर पुनः प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folder tujuan tidak dapat dibuat atau ditulis. Periksa izin dan ruang disk, lalu coba lagi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile creare o scrivere nella cartella di destinazione. Controlla i permessi e lo spazio su disco, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対象フォルダを作成または書き込みできません。権限とディスク容量を確認して再試行してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대상 폴더를 만들거나 쓸 수 없습니다. 권한과 디스크 공간을 확인한 후 다시 시도하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De doelmap kan niet worden aangemaakt of beschreven. Controleer rechten en schijfruimte en probeer het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można utworzyć folderu docelowego ani do niego zapisać. Sprawdź uprawnienia i miejsce na dysku, a następnie spróbuj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não é possível criar ou gravar na pasta de destino. Verifique as permissões e o espaço em disco e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось создать папку назначения или записать в неё. Проверьте права и свободное место на диске и повторите попытку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Målmappen kan inte skapas eller skrivas till. Kontrollera behörigheter och diskutrymme och försök igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไม่สามารถสร้างหรือเขียนลงในโฟลเดอร์ปลายทางได้ ตรวจสอบสิทธิ์และพื้นที่ดิสก์แล้วลองอีกครั้ง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hedef klasör oluşturulamıyor veya yazılamıyor. İzinleri ve disk alanını kontrol edip yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося створити цільову теку або записати до неї. Перевірте дозволи та вільне місце на диску й повторіть спробу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể tạo hoặc ghi vào thư mục đích. Hãy kiểm tra quyền và dung lượng đĩa rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标文件夹不可创建或不可写入，请检查权限与磁盘空间后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法建立或寫入目標資料夾，請檢查權限與磁碟空間後重試。"
          }
        }
      }
    },
    "目标磁盘为只读，请更换存储位置。" : {
