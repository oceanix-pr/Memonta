    "视频轨保存异常，音频录音不受影响；条目以纯音频入库。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل حفظ مسار الفيديو؛ التسجيل الصوتي غير متأثر وسيُحفظ العنصر صوتيًا فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Videospur konnte nicht gespeichert werden; die Audioaufnahme ist nicht betroffen, der Eintrag wird nur als Audio gesichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The video track could not be saved; the audio recording is unaffected and the item is saved as audio only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar la pista de vídeo; el audio no se ve afectado y el elemento se guarda solo como audio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l’enregistrement de la piste vidéo ; l’audio n’est pas affecté et l’élément est enregistré en audio seul."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वीडियो ट्रैक सहेजा नहीं जा सका; ऑडियो रिकॉर्डिंग प्रभावित नहीं है और आइटम केवल ऑडियो के रूप में सहेजा गया।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal menyimpan track video; rekaman audio tidak terpengaruh dan item disimpan hanya sebagai audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvataggio della traccia video non riuscito; l’audio non è interessato e l’elemento viene salvato solo come audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映像トラックの保存に失敗しました。音声録音には影響せず、項目は音声のみで保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "비디오 트랙 저장 실패. 오디오 녹음은 영향받지 않으며 항목은 오디오만 저장됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan videospoor niet opslaan; de audio-opname is niet getroffen en het item wordt alleen als audio opgeslagen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać ścieżki wideo; nagranie audio nie ucierpiało, element zapisano jako samo audio."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao guardar a faixa de vídeo; o áudio não é afetado e o item é guardado apenas como áudio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Видеодорожку не удалось сохранить; аудиозапись не пострадала, элемент сохранён только как аудио."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde inte spara videospåret; ljudinspelningen påverkas inte och objektet sparas endast som ljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกแทรกวิดีโอไม่สำเร็จ การบันทึกเสียงไม่ได้รับผลกระทบ และรายการจะถูกบันทึกเป็นเสียงอย่างเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Video kanalı kaydedilemedi; ses kaydı etkilenmedi ve öğe yalnızca ses olarak kaydedildi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відеодоріжку не вдалося зберегти; аудіозапис не постраждав, елемент збережено лише як аудіо."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu track video thất bại; bản ghi âm không bị ảnh hưởng, mục được lưu chỉ với âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频轨保存异常，音频录音不受影响；条目以纯音频入库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片軌儲存異常，音訊錄音不受影響；項目以純音訊入庫。"
          }
        }
      }
    },
    "视频音轨抽取超时（导出器无响应），请重试或改用较短的视频" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهت مهلة استخراج الصوت من الفيديو (المُصدِّر لا يستجيب). أعد المحاولة أو استخدم فيديو أقصر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeitüberschreitung beim Extrahieren der Tonspur (Exporter reagiert nicht). Bitte erneut versuchen oder ein kürzeres Video verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timed out extracting audio from the video (exporter unresponsive). Please try again or use a shorter video."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se agotó el tiempo al extraer el audio del vídeo (el exportador no responde). Reinténtalo o usa un vídeo más corto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Délai dépassé lors de l’extraction de l’audio (exportateur ne répond pas). Réessayez ou utilisez une vidéo plus courte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वीडियो से ऑडियो निकालने का समय समाप्त (एक्सपोर्टर जवाब नहीं दे रहा)। पुनः प्रयास करें या छोटा वीडियो चुनें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waktu habis saat mengekstrak audio dari video (pengekspor tidak merespons). Coba lagi atau gunakan video lebih pendek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timeout nell’estrazione dell’audio dal video (esportatore non risponde). Riprova o usa un video più corto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動画からの音声抽出がタイムアウトしました（エクスポータが応答しません）。再試行するか、短い動画をお使いください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동영상에서 오디오 추출 시간이 초과되었습니다(내보내기 응답 없음). 다시 시도하거나 더 짧은 동영상을 사용하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time-out bij het extraheren van audio uit de video (exporter reageert niet). Probeer opnieuw of gebruik een kortere video."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przekroczono czas wyodrębniania dźwięku z wideo (eksporter nie odpowiada). Spróbuj ponownie lub użyj krótszego wideo."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo esgotado ao extrair o áudio do vídeo (exportador sem resposta). Tente de novo ou use um vídeo mais curto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Превышено время извлечения звука из видео (экспортёр не отвечает). Повторите попытку или возьмите видео короче."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidsgränsen överskreds vid ljudutdragning (exportören svarar inte). Försök igen eller använd en kortare video."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หมดเวลาในการดึงเสียงจากวิดีโอ (ตัวส่งออกไม่ตอบสนอง) โปรดลองใหม่หรือใช้วิดีโอที่สั้นลง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videodan ses çıkarma zaman aşımına uğradı (dışa aktarıcı yanıt vermiyor). Yeniden deneyin veya daha kısa bir video kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевищено час вилучення звуку з відео (експортер не відповідає). Повторіть спробу або візьміть коротше відео."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hết thời gian trích xuất âm thanh từ video (bộ xuất không phản hồi). Hãy thử lại hoặc dùng video ngắn hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "视频音轨抽取超时（导出器无响应），请重试或改用较短的视频"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "影片音軌抽取逾時（匯出器無回應），請重試或改用較短的影片"
          }
        }
      }
    },
