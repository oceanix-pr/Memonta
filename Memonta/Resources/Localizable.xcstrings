            "value" : "Menggunakan mikrofon untuk merekam percakapan di ruang yang sama."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa il microfono per registrare conversazioni nello stesso spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
