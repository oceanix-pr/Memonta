    "总结前判定内容是否为会议时使用（决定走会议模板还是概要模板）。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُستخدم لتحديد ما إذا كان المحتوى اجتماعًا قبل التلخيص (يختار بين قالب الاجتماع والقالب الموجز)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird verwendet, um vor dem Zusammenfassen zu bestimmen, ob der Inhalt eine Sitzung ist (entscheidet zwischen Sitzungs- und Kurzvorlage)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Used to determine whether the content is a meeting before summarizing (decides between the meeting template and the brief template)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para determinar si el contenido es una reunión antes de resumir (decide entre la plantilla de reunión y la breve)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour déterminer si le contenu est une réunion avant le résumé (choisit entre le modèle de réunion et le modèle bref)."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सारांश से पहले यह तय करने के लिए उपयोग किया जाता है कि सामग्री बैठक है या नहीं (बैठक टेम्पलेट या संक्षिप्त टेम्पलेट चुनता है)।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digunakan untuk menentukan apakah konten adalah rapat sebelum meringkas (memilih antara templat rapat dan templat singkat)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usato per determinare se il contenuto è una riunione prima del riepilogo (decide tra il modello riunione e quello breve)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要約の前に内容が会議かどうかを判定するときに使用します（会議テンプレートか概要テンプレートかを決めます）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요약 전에 내용이 회의인지 판별할 때 사용합니다(회의 템플릿과 요약 템플릿 중 선택)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt gebruikt om vóór het samenvatten te bepalen of de inhoud een vergadering is (kiest tussen het vergader- en het korte sjabloon)."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Służy do ustalenia przed podsumowaniem, czy treść jest spotkaniem (decyduje między szablonem spotkania a szablonem krótkim)."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para determinar se o conteúdo é uma reunião antes do resumo (decide entre o modelo de reunião e o breve)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для определения перед резюме, является ли содержимое встречей (выбирает шаблон встречи или краткий шаблон)."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Används för att avgöra om innehållet är ett möte före sammanfattningen (väljer mellan mötesmallen och den korta mallen)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ใช้สำหรับตัดสินว่าเนื้อหาเป็นการประชุมหรือไม่ก่อนสรุป (เลือกใช้เทมเพลตการประชุมหรือเทมเพลตสรุปย่อ)"
          }
        },
        "tr" : {
          "stringUnit" : {
