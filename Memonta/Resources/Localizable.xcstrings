        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대표 화면을 추출해 동영상 타임라인에 따라 슬라이드·문서·코드·공유 화면을 기록합니다. 다시 분석할 때는 기존 키프레임을 재사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
