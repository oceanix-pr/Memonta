        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin abrir la ventana principal, inicie/detenga la grabación directamente desde la barra de menús o lance capturas de región/ventana/pantalla completa"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans ouvrir la fenêtre principale, démarrez/arrêtez l'enregistrement directement depuis la barre des menus, ou lancez des captures de zone/fenêtre/plein écran"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मुख्य विंडो खोले बिना, सीधे मेनू बार से रिकॉर्डिंग शुरू/रोकें, या क्षेत्र/विंडो/पूर्णस्क्रीन स्क्रीनशॉट चालू करें"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tanpa membuka jendela utama, mulai/hentikan perekaman langsung dari bilah menu, atau jalankan tangkapan area/jendela/layar penuh"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza aprire la finestra principale, avvia/interrompi la registrazione direttamente dalla barra dei menu, o lancia screenshot di area/finestra/schermo intero"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メインウインドウを開かなくても、メニューバーから直接録音を開始/停止したり、範囲/ウインドウ/全画面のスクリーンショットを実行できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주 윈도우를 열지 않고도 메뉴 막대에서 바로 녹음을 시작/중지하거나 영역/창/전체 화면 스크린샷을 실행할 수 있습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zonder het hoofdvenster te openen, start/stop u opnamen rechtstreeks vanuit de menubalk, of start u schermafdrukken van gebied/venster/volledig scherm"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bez otwierania okna głównego rozpocznij/zatrzymaj nagrywanie bezpośrednio z paska menu lub uruchom zrzuty obszaru/okna/pełnego ekranu"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem abrir a janela principal, inicie/pare a gravação diretamente da barra de menus ou acione capturas de região/janela/tela cheia"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не открывая главное окно, начинайте/останавливайте запись прямо из строки меню или запускайте снимки области/окна/всего экрана"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utan att öppna huvudfönstret, starta/stoppa inspelning direkt från menyraden, eller starta skärmdump av område/fönster/helskärm"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "โดยไม่ต้องเปิดหน้าต่างหลัก เริ่ม/หยุดการบันทึกได้โดยตรงจากแถบเมนู หรือเรียกใช้ภาพหน้าจอแบบพื้นที่/หน้าต่าง/เต็มจอ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana pencereyi açmadan, doğrudan menü çubuğundan kaydı başlatın/durdurun veya bölge/pencere/tam ekran görüntüsü başlatın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не відкриваючи головне вікно, починайте/зупиняйте запис прямо з рядка меню або запускайте знімки області/вікна/всього екрана"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không cần mở cửa sổ chính, bắt đầu/dừng ghi âm trực tiếp từ thanh menu, hoặc khởi động chụp vùng/cửa sổ/toàn màn hình"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需打开主窗口，可直接从菜单栏开始/停止录音，或发起区域/窗口/全屏截图"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無需開啟主視窗，可直接從選單列開始/停止錄音，或發起區域/視窗/全螢幕截圖"
          }
        }
      }
    },
