        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คีย์เฟรมและบันทึกภาพยังคงอยู่ จึงวิเคราะห์ต่อหรือวิเคราะห์ใหม่ได้ เพียงแต่แยกคีย์เฟรมซ้ำไม่ได้"
