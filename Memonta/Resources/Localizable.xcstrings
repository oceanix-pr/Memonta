    "录音记录保存到数据库失败：%@\n录音文件已保存在磁盘上，请重启应用后检查是否自动恢复。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل حفظ سجل التسجيل في قاعدة البيانات: %@\nحُفظ ملف التسجيل على القرص. أعد تشغيل التطبيق وتحقق مما إذا كان سيُستعاد تلقائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufnahme konnte nicht in der Datenbank gespeichert werden: %@\nDie Aufnahmedatei wurde auf der Festplatte gespeichert. Starten Sie die App neu und prüfen Sie, ob sie automatisch wiederhergestellt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to save the recording entry to the database: %@\nThe recording file was saved on disk. Restart the app and check whether it is recovered automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar la entrada de grabación en la base de datos: %@\nEl archivo de grabación se guardó en disco. Reinicia la app y comprueba si se recupera automáticamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de l'enregistrement de l'entrée dans la base de données : %@\nLe fichier audio a été sauvegardé sur le disque. Redémarrez l'app et vérifiez s'il est récupéré automatiquement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिकॉर्डिंग प्रविष्टि को डेटाबेस में सहेजने में विफल: %@\nरिकॉर्डिंग फ़ाइल डिस्क पर सहेजी गई है। ऐप पुनः आरंभ करें और जाँचें कि वह स्वतः पुनर्प्राप्त होती है या नहीं।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal menyimpan entri rekaman ke basis data: %@\nFile rekaman telah disimpan di disk. Mulai ulang aplikasi dan periksa apakah dipulihkan otomatis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvataggio della voce di registrazione nel database non riuscito: %@\nIl file di registrazione è stato salvato su disco. Riavvia l'app e verifica se viene recuperato automaticamente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "録音をデータベースに保存できませんでした: %@\\\n録音ファイルはディスクに保存されています。アプリを再起動して自動復元を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "녹음 기록을 데이터베이스에 저장하지 못했습니다: %@\n녹음 파일은 디스크에 저장되었습니다. 앱을 재시작한 후 자동 복구 여부를 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opname-item in database bewaren mislukt: %@\nHet opnamebestand is op schijf bewaard. Start de app opnieuw en controleer of het automatisch wordt hersteld."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać wpisu nagrania do bazy danych: %@\nPlik nagrania został zapisany na dysku. Uruchom ponownie aplikację i sprawdź, czy zostanie automatycznie odzyskany."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao salvar a entrada de gravação no banco de dados: %@\nO arquivo de gravação foi salvo no disco. Reinicie o app e verifique se ele é recuperado automaticamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить запись в базу данных: %@\nФайл записи сохранён на диске. Перезапустите приложение и проверьте, восстановится ли она автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att spara inspelningsposten i databasen: %@\nInspelningsfilen sparades på disken. Starta om appen och kontrollera om den återställs automatiskt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึกรายการการบันทึกลงฐานข้อมูลไม่สำเร็จ: %@\nไฟล์การบันทึกถูกเก็บในดิสก์ รีสตาร์ทแอปและตรวจสอบว่าถูกกู้คืนโดยอัตโนมัติหรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt girişi veritabanına kaydedilemedi: %@\nKayıt dosyası diske kaydedildi. Uygulamayı yeniden başlatıp otomatik kurtarılıp kurtarılmadığını kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося зберегти запис у базу даних: %@\nФайл запису збережено на диску. Перезапустіть застосунок і перевірте, чи його відновлено автоматично."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lưu mục ghi âm vào cơ sở dữ liệu thất bại: %@\nTệp ghi âm đã được lưu trên đĩa. Khởi động lại ứng dụng và kiểm tra xem nó có được tự động khôi phục không."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "录音记录保存到数据库失败：%@\n录音文件已保存在磁盘上，请重启应用后检查是否自动恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錄音記錄儲存到數據庫失敗：%@\n錄音文件已儲存在磁盤上，請重啓應用後檢查是否自動恢復。"
          }
        }
      }
    },
    "录音过程中可在顶部工具栏查看时长和静音状态" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
