          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screenshot todos support writing to system Reminders, with automatic sync on modification/deletion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tareas de capturas admiten escribirse en Recordatorios del sistema, con sincronización automática al modificar/eliminar"
