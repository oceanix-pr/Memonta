          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ไฟล์นี้ถอดรหัสบนเครื่องนี้ไม่ได้ อาจส่งออกจาก Mac เครื่องอื่นหรือไฟล์เสียหาย"
