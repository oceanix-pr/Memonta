        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa lo strumento di selezione per fare clic e selezionare singole annotazioni; supporta spostamento, eliminazione (tasto Delete) e modifica delle proprietà"
