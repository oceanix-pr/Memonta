    },
    "\n⚠️ 录音分片拼接失败，分片文件已保留在录音文件夹（共 %d 个），请手动处理。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ فشل دمج مقاطع التسجيل. تم الاحتفاظ بملفات المقاطع في مجلد التسجيل (العدد الإجمالي %d). يرجى معالجتها يدويًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Zusammenfügen der Aufnahmefragmente fehlgeschlagen. Die Fragmente wurden im Aufnahmeordner behalten (insgesamt %d). Bitte manuell verarbeiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Failed to concatenate recording chunks. The chunk files have been kept in the recording folder (%d in total). Please handle them manually."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Error al unir los fragmentos de grabación. Los archivos se han conservado en la carpeta de grabación (%d en total). Procésalos manualmente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Échec de l’assemblage des fragments d’enregistrement. Les fichiers ont été conservés dans le dossier d’enregistrement (%d au total). Veuillez les traiter manuellement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ रिकॉर्डिंग खंड जोड़ने में विफल। खंड फ़ाइलें रिकॉर्डिंग फ़ोल्डर में रखी गई हैं (कुल %d)। कृपया मैन्युअल रूप से संभालें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Gagal menggabungkan potongan rekaman. Berkas potongan tetap disimpan di folder rekaman (total %d). Silakan tangani secara manual."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Unione dei frammenti di registrazione non riuscita. I file sono stati conservati nella cartella delle registrazioni (%d in totale). Gestiscili manualmente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ 録音チャンクの結合に失敗しました。チャンクファイルは録音フォルダに保持されています（計 %d 個）。手動で処理してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ 녹음 조각 이어붙이기에 실패했습니다. 조각 파일은 녹음 폴더에 보관되어 있습니다(총 %d개). 수동으로 처리하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Samenvoegen van opnamefragmenten mislukt. De fragmentbestanden zijn bewaard in de opnamemap (%d in totaal). Verwerk ze handmatig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Nie udało się połączyć fragmentów nagrania. Pliki fragmentów zostały zachowane w folderze nagrania (łącznie %d). Obsłuż je ręcznie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Falha ao juntar os fragmentos da gravação. Os arquivos foram mantidos na pasta de gravação (%d no total). Processe-os manualmente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Не удалось склеить фрагменты записи. Файлы фрагментов сохранены в папке записи (всего %d). Обработайте их вручную."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Kunde inte slå ihop inspelningsdelarna. Delfilerna har behållits i inspelningsmappen (totalt %d). Hantera dem manuellt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ ต่อรวมชิ้นส่วนการบันทึกเสียงล้มเหลว ไฟล์ชิ้นส่วนถูกเก็บไว้ในโฟลเดอร์บันทึกเสียง (ทั้งหมด %d ไฟล์) กรุณาดำเนินการด้วยตนเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Kayıt parçaları birleştirilemedi. Parça dosyaları kayıt klasöründe tutuldu (toplam %d). Lütfen elle işlem yapın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Не вдалося склеїти фрагменти запису. Файли фрагментів збережено в папці запису (усього %d). Обробіть їх вручну."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Ghép các đoạn ghi âm thất bại. Các tệp đoạn đã được giữ trong thư mục ghi âm (tổng cộng %d). Vui lòng xử lý thủ công."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ 录音分片拼接失败，分片文件已保留在录音文件夹（共 %d 个），请手动处理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ 錄音分片拼接失敗，分片檔案已保留在錄音資料夾（共 %d 個），請手動處理。"
          }
        }
      }
    },
    "\n⚠️ 系统音频重连失败，后续录音将仅包含麦克风音轨。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ فشل إعادة الاتصال بصوت النظام. سيحتوي التسجيل اللاحق على مسار الميكروفون فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Systemaudio konnte nicht wiederhergestellt werden. Weitere Aufnahmen enthalten nur die Mikrofonspur."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Failed to reconnect system audio. Subsequent recording will only contain the microphone track."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Error al reconectar el audio del sistema. La grabación posterior solo contendrá la pista del micrófono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Échec de la reconnexion de l’audio système. La suite de l’enregistrement ne contiendra que la piste du microphone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ सिस्टम ऑडियो पुनः कनेक्ट करने में विफल। बाद की रिकॉर्डिंग में केवल माइक्रोफ़ोन ट्रैक होगा।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Gagal menyambung ulang audio sistem. Rekaman berikutnya hanya akan berisi trek mikrofon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Riconnessione dell’audio di sistema non riuscita. Le registrazioni successive conterranno solo la traccia del microfono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ システム音声の再接続に失敗しました。以降の録音にはマイク音轨のみが含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ 시스템 오디오 재연결에 실패했습니다. 이후 녹음에는 마이크 음轨만 포함됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Systeemgeluid opnieuw verbinden mislukt. Latere opnamen bevatten alleen de microfoontrack."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Nie udało się ponownie połączyć dźwięku systemowego. Dalsze nagrania będą zawierać tylko ścieżkę mikrofonu."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Falha ao reconectar o áudio do sistema. As gravações subsequentes conterão apenas a faixa do microfone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Не удалось переподключить системный звук. Дальнейшая запись будет содержать только дорожку микрофона."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Kunde inte återansluta systemljudet. Fortsatt inspelning innehåller bara mikrofonspåret."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ เชื่อมต่อเสียงระบบใหม่ล้มเหลว การบันทึกต่อจากนี้จะมีเฉพาะแทร็กไมโครโฟน"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Sistem sesi yeniden bağlanamadı. Bundan sonraki kayıt yalnızca mikrofon izini içerecek."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Не вдалося повторно під’єднати системний звук. Подальший запис міститиме лише доріжку мікрофона."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Kết nối lại âm thanh hệ thống thất bại. Phần ghi âm tiếp theo sẽ chỉ chứa rãnh micro."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ 系统音频重连失败，后续录音将仅包含麦克风音轨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ 系統音訊重連失敗，後續錄音將僅包含麥克風音軌。"
          }
        }
      }
    },
    "\n⚠️ 麦克风音轨恢复失败，请检查麦克风设备后重新录音。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ فشل استعادة مسار الميكروفون. يرجى فحص جهاز الميكروفون ثم إعادة التسجيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Wiederherstellung der Mikrofonspur fehlgeschlagen. Bitte Mikrofon prüfen und erneut aufnehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Failed to recover the microphone track. Please check the microphone device and record again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Error al recuperar la pista del micrófono. Comprueba el micrófono y vuelve a grabar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Échec de la récupération de la piste microphone. Vérifiez le microphone puis réenregistrez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ माइक्रोफ़ोन ट्रैक पुनर्प्राप्त करने में विफल। कृपया माइक्रोफ़ोन जाँचकर फिर रिकॉर्ड करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Gagal memulihkan trek mikrofon. Periksa perangkat mikrofon lalu rekam ulang."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Ripristino della traccia microfono non riuscito. Controlla il microfono e registra di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ マイク音声トラックの復旧に失敗しました。マイクデバイスを確認してから再録音してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ 마이크 트랙 복구에 실패했습니다. 마이크 장치를 확인한 후 다시 녹음하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Herstellen van de microfoontrack mislukt. Controleer de microfoon en neem opnieuw op."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Nie udało się przywrócić ścieżki mikrofonu. Sprawdź mikrofon i nagraj ponownie."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Falha ao recuperar a faixa do microfone. Verifique o microfone e grave novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Не удалось восстановить дорожку микрофона. Проверьте микрофон и запишите заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Kunde inte återställa mikrofonspåret. Kontrollera mikrofonen och spela in igen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ กู้คืนแทร็กไมโครโฟนล้มเหลว กรุณาตรวจสอบอุปกรณ์ไมโครโฟนแล้วบันทึกใหม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Mikrofon izi kurtarılamadı. Lütfen mikrofonu kontrol edip yeniden kaydedin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Не вдалося відновити доріжку мікрофона. Перевірте мікрофон і запишіть знову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ Khôi phục rãnh micro thất bại. Vui lòng kiểm tra thiết bị micro rồi ghi âm lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ 麦克风音轨恢复失败，请检查麦克风设备后重新录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\n⚠️ 麥克風音軌恢復失敗，請檢查麥克風設備後重新錄音。"
          }
        }
      }
    },
