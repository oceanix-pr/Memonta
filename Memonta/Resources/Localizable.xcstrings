    "待办支持手动新增、编辑、删除，不锁定于 AI 结果" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن إضافة المهام وتعديلها وحذفها يدويًا — لا تقتصر على نتائج الذكاء الاصطناعي"
          }
        },
        "de" : {
          "stringUnit" : {
