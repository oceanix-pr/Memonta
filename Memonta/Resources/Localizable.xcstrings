        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún hay tareas en segundo plano pendientes. Espere a que la cola esté vacía antes de cambiar la carpeta de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des tâches d'arrière-plan sont encore en attente. Attendez que la file soit vide avant de changer le dossier de données."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी भी पृष्ठभूमि कार्य लंबित हैं। डेटा फ़ोल्डर बदलने से पहले कतार खाली होने की प्रतीक्षा करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masih ada tugas latar belakang yang tertunda. Tunggu hingga antrean kosong sebelum mengubah folder data."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sono ancora attività in background in sospeso. Attendi che la coda sia vuota prima di cambiare la cartella dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ処理待ちのバックグラウンドタスクがあります。キューが空になってからデータフォルダを変更してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 처리 대기 중인 백그라운드 작업이 있습니다. 대기열이 비워진 후 데이터 폴더를 변경하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
