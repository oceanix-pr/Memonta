    "截图待办支持写入系统「提醒事项」，修改/删除自动同步" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدعم مهام لقطة الشاشة الكتابة في تطبيق “التذكيرات” بالنظام، مع مزامنة تلقائية عند التعديل/الحذف"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
