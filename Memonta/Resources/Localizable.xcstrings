    "菜单栏「从剪贴板新建笔记」可把剪贴板文字快速存为快捷笔记" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«إنشاء ملاحظة من الحافظة» في شريط القوائم يحفظ نص الحافظة بسرعة كملاحظة سريعة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Notiz aus Zwischenablage“ in der Menüleiste speichert den Zwischenablagentext schnell als Notiz"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“New Note from Clipboard” in the menu bar quickly saves clipboard text as a quick note"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Nueva nota desde el portapapeles» en la barra de menús guarda rápidamente el texto del portapapeles como nota rápida"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Nouvelle note depuis le presse-papiers » dans la barre de menus enregistre rapidement le texte comme note rapide"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मेन्यू बार में “क्लिपबोर्ड से नई नोट” क्लिपबोर्ड टेक्स्ट को तुरंत नोट के रूप में सहेजता है"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Catatan Baru dari Papan Klip” di bilah menu menyimpan teks papan klip sebagai catatan cepat"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Nuova nota dagli appunti” nella barra dei menu salva rapidamente il testo come nota rapida"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メニューバーの「クリップボードから新規ノート」でクリップボードのテキストを素早くノートとして保存できます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메뉴 막대의 ‘클립보드에서 새 노트’로 클립보드 텍스트를 빠르게 노트로 저장할 수 있습니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Nieuwe notitie uit klembord’ in de menubalk slaat klembordtekst snel op als notitie"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nowa notatka ze schowka“ na pasku menu szybko zapisuje tekst ze schowka jako notatkę"
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Nova nota da área de transferência» na barra de menus guarda rapidamente o texto como nota"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Новая заметка из буфера» в строке меню быстро сохраняет текст буфера как заметку"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Ny anteckning från urklipp” i menyraden sparar snabbt urklippstext som en anteckning"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“สร้างโน้ตใหม่จากคลิปบอร์ด” ในแถบเมนูช่วยบันทึกข้อความในคลิปบอร์ดเป็นโน้ตอย่างรวดเร็ว"
          }
        },
        "tr" : {
          "stringUnit" : {
