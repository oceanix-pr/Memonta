          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det gick inte att radera från Påminnelser; poster kan finnas kvar i systemets Påminnelser-app. Radera dem manuellt."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลบจากเตือนความจำไม่สำเร็จ รายการอาจยังอยู่ในแอปเตือนความจำของระบบ โปรดลบด้วยตนเอง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anımsatıcılar'dan silinemedi; sistem Anımsatıcılar uygulamasında girişler kalmış olabilir. Lütfen oradan manuel silin."
          }
        },
        "uk" : {
