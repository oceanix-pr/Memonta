    "%d 条录音自动恢复失败：%@。\n分片文件已保留在录音文件夹，可用专业音频工具尝试修复。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشل الاسترجاع التلقائي لـ %d تسجيلًا: %@.\nتبقى الملفات المجزأة في مجلد التسجيل؛ جرّب إصلاحها بأدوات صوتية احترافية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d Aufnahmen konnten nicht automatisch wiederhergestellt werden: %@.\nDie Segmentdateien bleiben im Aufnahmeordner; versuchen Sie eine Reparatur mit professionellen Audio-Tools."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Failed to auto-recover %d recordings: %@.\nThe segment files remain in the recording folder; try repairing them with professional audio tools."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron recuperar automáticamente %d grabaciones: %@.\nLos fragmentos siguen en la carpeta de grabación; prueba a repararlos con herramientas de audio profesionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Échec de la récupération automatique de %d enregistrements : %@.\nLes fragments restent dans le dossier d’enregistrement ; essayez de les réparer avec un outil audio professionnel."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d रिकॉर्डिंग अपने-आप बहाल नहीं हो सकीं: %@।\nखंड फ़ाइलें रिकॉर्डिंग फ़ोल्डर में हैं; पेशेवर ऑडियो टूल से ठीक करने का प्रयास करें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagal memulihkan otomatis %d rekaman: %@.\nFile segmen tetap di folder perekaman; coba perbaiki dengan alat audio profesional."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recupero automatico di %d registrazioni non riuscito: %@.\nI file suddivisi restano nella cartella di registrazione; prova a ripararli con strumenti audio professionali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d 件の録音の自動復元に失敗しました：%@。\n分割ファイルは録音フォルダに残っています。専門の音声ツールでの修復をお試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d개 녹음 자동 복구 실패: %@.\n분할 파일은 녹음 폴더에 남아 있으며, 전문 오디오 도구로 복구를 시도할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d opnamen konden niet automatisch worden hersteld: %@.\nDe segmentbestanden blijven in de opnamemap; probeer ze te repareren met professionele audiotools."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się automatycznie odzyskać %d nagrań: %@.\nPliki segmentów pozostały w folderze nagrania; spróbuj naprawić je profesjonalnym narzędziem audio."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Falha ao recuperar automaticamente %d gravações: %@.\nOs fragmentos permanecem na pasta de gravação; tente repará-los com ferramentas de áudio profissionais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось автоматически восстановить записей: %d — %@.\nФрагменты остались в папке записи; попробуйте восстановить их профессиональным аудиоредактором."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunde inte återställa %d inspelningar automatiskt: %@.\nSegmentsfilerna finns kvar i inspelningsmappen; försök reparera dem med professionella ljudverktyg."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "กู้คืนการบันทึก %d รายการอัตโนมัติไม่สำเร็จ: %@\nไฟล์แบ่งชิ้นยังอยู่ในโฟลเดอร์บันทึก ลองซ่อมด้วยเครื่องมือเสียงระดับมืออาชีพ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d kayıt otomatik kurtarılamadı: %@.\nBölüm dosyaları kayıt klasöründe duruyor; profesyonel ses araçlarıyla onarmayı deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося автоматично відновити %d записів: %@.\nФрагменти залишилися в теці запису; спробуйте відновити їх професійним аудіоінструментом."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khôi phục tự động %d bản ghi thất bại: %@.\nCác tệp phân đoạn vẫn trong thư mục ghi; hãy thử sửa bằng công cụ âm thanh chuyên nghiệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$d 条录音自动恢复失败：%2$@。\n分片文件已保留在录音文件夹，可用专业音频工具尝试修复。"
          }
