        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es stehen noch Hintergrundaufgaben aus. Bitte warten Sie, bis die Warteschlange leer ist, bevor Sie den Datenordner ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are still background tasks pending. Please wait until the queue is empty before changing the data folder."
          }
