    "部分待办写入失败：成功 %@ 个，失败 %@ 个" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كتابة جزئية للمهام: نجح %@، فشل %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teils fehlgeschlagenes Schreiben der Aufgaben: %@ erfolgreich, %@ fehlgeschlagen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some to-dos failed to write: %@ succeeded, %@ failed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escritura parcial de tareas: %@ correctas, %@ fallidas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Écriture partielle des tâches : %@ réussies, %@ échouées"
          }
        },
        "hi" : {
