    "系统音频采集异常停止，录音将继续但仅包含麦克风音轨。\n%@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف التقاط صوت النظام بشكل غير متوقع؛ سيستمر التسجيل بمسار الميكروفون فقط.\n%@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Systemaudio-Erfassung wurde unerwartet beendet; die Aufnahme wird nur mit der Mikrofonspur fortgesetzt.\n%@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "System audio capture stopped unexpectedly; recording will continue with the microphone track only.\n%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La captura de audio del sistema se detuvo inesperadamente; la grabación continuará solo con la pista del micrófono.\n%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La capture de l'audio système s'est arrêtée de façon inattendue ; l'enregistrement continue avec la piste micro uniquement.\n%@"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सिस्टम ऑडियो कैप्चर अप्रत्याशित रूप से रुका; रिकॉर्डिंग केवल माइक्रोफ़ोन ट्रैक से जारी रहेगी।\n%@"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Penangkapan audio sistem berhenti tak terduga; rekaman akan berlanjut hanya dengan trek mikrofon.\n%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cattura dell'audio di sistema si è interrotta in modo imprevisto; la registrazione continuerà solo con la traccia del microfono.\n%@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム音声の取り込みが異常停止しました。録音はマイクトラックのみで継続されます。\\\n%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
