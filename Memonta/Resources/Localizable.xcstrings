        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvir o primeiro segmento deste falante para ajudar a identificá-lo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прослушать самый ранний фрагмент этого говорящего, чтобы понять, кто это"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lyssna på talarens tidigaste segment för att lättare avgöra vem det är"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ฟังช่วงแรกสุดของผู้พูดรายนี้เพื่อช่วยระบุว่าเป็นใคร"
