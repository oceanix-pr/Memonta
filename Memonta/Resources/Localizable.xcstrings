          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przechwytywanie dźwięku systemowego zatrzymało się niespodziewanie; nagrywanie będzie kontynuowane tylko ze ścieżką mikrofonu.\n%@"
          }
        },
        "pt" : {
