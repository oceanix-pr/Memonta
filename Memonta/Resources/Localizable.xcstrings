    "处理失败，请重试；若反复失败请检查模型配置与网络。" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فشلت المعالجة. أعد المحاولة؛ وإذا تكرر الفشل فتحقق من إعداد النموذج والشبكة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verarbeitung fehlgeschlagen. Bitte erneut versuchen; bei wiederholtem Fehlschlag Modellkonfiguration und Netzwerk prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Processing failed. Please try again; if it keeps failing, check the model configuration and network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El procesamiento falló. Inténtalo de nuevo; si falla repetidamente, revisa la configuración del modelo y la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le traitement a échoué. Réessayez ; en cas d'échec répété, vérifiez la configuration du modèle et le réseau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रोसेसिंग विफल रही। फिर से प्रयास करें; बार-बार विफल होने पर मॉडल कॉन्फ़िगरेशन और नेटवर्क जाँचें।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pemrosesan gagal. Coba lagi; jika terus gagal, periksa konfigurasi model dan jaringan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elaborazione non riuscita. Riprova; se continua a fallire, controlla la configurazione del modello e la rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "処理に失敗しました。再試行してください。繰り返し失敗する場合はモデル設定とネットワークを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "처리에 실패했습니다. 다시 시도하세요. 계속 실패하면 모델 설정과 네트워크를 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwerking mislukt. Probeer het opnieuw; controleer bij herhaald falen de modelconfiguratie en het netwerk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przetwarzanie nie powiodło się. Spróbuj ponownie; jeśli błąd się powtarza, sprawdź konfigurację modelu i sieć."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O processamento falhou. Tente novamente; se falhar repetidamente, verifique a configuração do modelo e a rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обработка не удалась. Повторите попытку; при повторных сбоях проверьте настройки модели и сеть."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbetningen misslyckades. Försök igen; kontrollera modellkonfiguration och nätverk vid upprepade fel."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การประมวลผลล้มเหลว กรุณาลองใหม่ หากยังล้มเหลวซ้ำ ๆ กรุณาตรวจสอบการตั้งค่าโมเดลและเครือข่าย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İşlem başarısız oldu. Yeniden deneyin; tekrar başarısız olursa model yapılandırmasını ve ağı kontrol edin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обробка не вдалася. Повторіть спробу; якщо збої повторюються, перевірте налаштування моделі та мережу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xử lý thất bại. Vui lòng thử lại; nếu vẫn thất bại, hãy kiểm tra cấu hình mô hình và mạng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "处理失败，请重试；若反复失败请检查模型配置与网络。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "處理失敗，請重試；若反覆失敗請檢查模型設定與網路。"
