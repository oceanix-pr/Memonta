        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta потрібен доступ до розпізнавання мовлення для локальної транскрипції записів зустрічей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta cần quyền truy cập nhận dạng giọng nói để chuyển lời bản ghi cuộc họp ngay trên máy."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta 需要访问语音识别以在本地将会议录音转成文字"
