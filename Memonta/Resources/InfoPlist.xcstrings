        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta потрібен доступ до мікрофона, щоб записувати звук зустрічей."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta cần quyền truy cập micrô để ghi âm cuộc họp."
