        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta 需要访问麦克风以录制会议音频"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta 需要存取麥克風以錄製會議音訊"
          }
        }
      }
    },
    "NSRemindersUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Memonta إلى الوصول إلى التذكيرات لكتابة المهام المستخرجة بالذكاء الاصطناعي في تذكيرات النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta benötigt Zugriff auf Erinnerungen, um von der KI extrahierte To-dos in die System-Erinnerungen zu schreiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta needs access to Reminders to write AI-extracted to-dos into the system Reminders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta necesita acceso a Recordatorios para escribir en Recordatorios del sistema las tareas extraídas por la IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta a besoin d’accéder aux Rappels pour écrire dans les Rappels système les tâches extraites par l’IA."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta को AI द्वारा निकाले गए कार्यों को सिस्टम रिमाइंडर में लिखने के लिए रिमाइंडर तक पहुँच चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta memerlukan akses ke Pengingat untuk menulis tugas hasil ekstraksi AI ke Pengingat sistem."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta necessita dell’accesso a Promemoria per scrivere nei Promemoria di sistema le attività estratte dall’IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta が AI が抽出した To-Do をシステムのリマインダーに書き込むためにリマインダーへのアクセスを必要としています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta가 AI가 추출한 할 일을 시스템 미리 알림에 기록하려면 미리 알림에 접근해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta heeft toegang tot Herinneringen nodig om door AI geëxtraheerde taken naar de systeem-Herinneringen te schrijven."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta potrzebuje dostępu do Przypomnienia, aby zapisywać zadania wyodrębnione przez AI w systemowych Przypomnieniach."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Memonta precisa de acesso aos Lembretes para gravar nos Lembretes do sistema as tarefas extraídas pela IA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta требуется доступ к Напоминаниям, чтобы записывать задачи, извлечённые ИИ, в системные Напоминания."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta behöver åtkomst till Påminnelser för att skriva AI-utdragna uppgifter till systemets Påminnelser."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta ต้องการเข้าถึงรายการเตือนเพื่อเขียนสิ่งที่ต้องทำที่ AI สกัดได้ลงในรายการเตือนของระบบ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta, yapay zekânın çıkardığı yapılacakları sistem Hatırlatıcıları’na yazmak için Hatırlatıcılar’a erişim gerektirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta потрібен доступ до Нагадувань, щоб записувати завдання, витягнуті ШІ, у системні Нагадування."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta cần quyền truy cập Ứng dụng Nhắc việc để ghi các việc cần làm do AI trích xuất vào Nhắc việc của hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta 需要访问提醒事项以将 AI 拆解的待办写入系统提醒事项"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta 需要存取提醒事項以將 AI 拆解的待辦寫入系統提醒事項"
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
