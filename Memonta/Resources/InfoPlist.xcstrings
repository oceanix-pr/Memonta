    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Memonta إلى الوصول إلى الميكروفون لتسجيل صوت الاجتماع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta benötigt Zugriff auf das Mikrofon, um Besprechungsaudio aufzunehmen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta needs access to the microphone to record meeting audio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta necesita acceso al micrófono para grabar el audio de las reuniones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta a besoin d’accéder au microphone pour enregistrer l’audio des réunions."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta को बैठक का ऑडियो रिकॉर्ड करने के लिए माइक्रोफ़ोन तक पहुँच चाहिए।"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta memerlukan akses ke mikrofon untuk merekam audio rapat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta necessita dell’accesso al microfono per registrare l’audio delle riunioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta が会議の音声を録音するためにマイクへのアクセスを必要としています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta가 회의 오디오를 녹음하려면 마이크에 접근해야 합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta heeft toegang tot de microfoon nodig om vergaderaudio op te nemen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta potrzebuje dostępu do mikrofonu, aby nagrywać dźwięk spotkań."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Memonta precisa de acesso ao microfone para gravar o áudio das reuniões."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta требуется доступ к микрофону для записи звука встреч."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta behöver åtkomst till mikrofonen för att spela in mötesljud."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta ต้องการเข้าถึงไมโครโฟนเพื่อบันทึกเสียงการประชุม"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memonta, toplantı sesini kaydetmek için mikrofona erişim gerektirir."
